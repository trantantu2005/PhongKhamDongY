    private string StockText(
        decimal stock,
        decimal minimum)
    {
        if (stock <= 0)
            return "Hết hàng";

        if (stock <= minimum)
            return "Sắp hết";

        return "Còn hàng";
    }

    private string StockClass(
        decimal stock,
        decimal minimum)
    {
        if (stock <= 0)
            return "staff-status danger";

        if (stock <= minimum)
            return "staff-status warning";

        return "staff-status success";
    }

