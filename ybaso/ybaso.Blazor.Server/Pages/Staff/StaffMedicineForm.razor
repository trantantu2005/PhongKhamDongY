</style>

@code {
    [Parameter]
    public int Oid { get; set; }

    private IObjectSpace objectSpace;
    private DanhMucThuoc Thuoc;

    private readonly List<MedicineIngredientRow>
        ThanhPhanTam = new();

    private readonly HashSet<int>
        SelectedDuocLieuOids = new();

    private List<ListDvt> DanhSachDvt = new();
    private List<DuocLieu> DanhSachDuocLieu = new();

    private string Message = string.Empty;

    private string MessageClass =
        "mf-alert mf-alert-success";

    private string MaThuoc = string.Empty;
    private string TenThuoc = string.Empty;

    private int SelectedDvtOid;

    private decimal SoLuongTon;
    private decimal SoLuongBoSung;
    private decimal TonToiThieu;
    private decimal GiaBan;

    private bool TuDongTinhGiaBan = true;

    private string SuDungValue = "true";
    private string MoTa = string.Empty;

    private string DuocLieuSearchText =
        string.Empty;

    private decimal SoLuongMacDinhChoDuocLieu = 1;

    private string GhiChuMacDinhChoDuocLieu =
        string.Empty;

    private bool IsSaving;

    private bool IsEditMode =>
        Oid > 0;

    private string PageTitle =>
        IsEditMode
            ? "Cập nhật thuốc / thang thuốc"
            : "Thêm thuốc / thang thuốc";

    private decimal SoLuongCanTaoLanNay =>
        IsEditMode
            ? SoLuongBoSung
            : SoLuongTon;

    private decimal GiaTinhTuDuocLieu =>
        ThanhPhanTam.Sum(
            x => x.SoLuong * x.GiaNhap
        );

    private decimal GiaBanHienTai =>
        TuDongTinhGiaBan
            ? GiaTinhTuDuocLieu
            : GiaBan;

    private string PreviewName =>
        string.IsNullOrWhiteSpace(TenThuoc)
            ? "Thuốc / thang thuốc mới"
            : TenThuoc;

    private string PreviewSubtitle
    {
        get
        {
            string trangThai =
                SuDungValue == "true"
                    ? "Đang dùng"
                    : "Ngừng dùng";

            return
                $"{FormatQuantity(SoLuongTon)} tồn kho" +
                $" • {FormatMoney(GiaBanHienTai)}" +
                $" • {ThanhPhanTam.Count} thành phần" +
                $" • {trangThai}";
        }
    }

    private IEnumerable<DuocLieu>
        DuocLieuDanhSachTick
    {
        get
        {
            HashSet<int> daThemVaoThanhPhan =
                ThanhPhanTam
                    .Select(x => x.DuocLieuOid)
                    .ToHashSet();

            IEnumerable<DuocLieu> query =
                DanhSachDuocLieu.Where(x =>
                    x.SuDung &&
                    !daThemVaoThanhPhan.Contains(
                        x.Oid
                    )
                );

            if (!string.IsNullOrWhiteSpace(
                DuocLieuSearchText))
            {
                string keyword =
                    DuocLieuSearchText
                        .Trim()
                        .ToLowerInvariant();

                query = query.Where(x =>
                    (x.MaDuocLieu ?? string.Empty)
                        .ToLowerInvariant()
                        .Contains(keyword) ||

                    (x.TenDuocLieu ?? string.Empty)
                        .ToLowerInvariant()
                        .Contains(keyword) ||

                    GetDvtName(x)
                        .ToLowerInvariant()
                        .Contains(keyword)
                );
            }

            return query
                .OrderBy(x => x.TenDuocLieu);
        }
    }

    private bool AreAllVisibleHerbsSelected
    {
        get
        {
            List<int> visibleIds =
                DuocLieuDanhSachTick
                    .Select(x => x.Oid)
                    .ToList();

            return
                visibleIds.Count > 0 &&
                visibleIds.All(
                    SelectedDuocLieuOids.Contains
                );
        }
    }

    protected override void OnInitialized()
    {
        objectSpace =
            ObjectSpaceFactory.CreateObjectSpace(
                typeof(DanhMucThuoc)
            );

        LoadData();
    }

    private void LoadData()
    {
        DanhSachDvt =
            objectSpace
                .GetObjects<ListDvt>()
                .OrderBy(x => x.TenDvt)
                .ToList();

        DanhSachDuocLieu =
            objectSpace
                .GetObjects<DuocLieu>()
                .OrderBy(x => x.TenDuocLieu)
                .ToList();

        ThanhPhanTam.Clear();
        SelectedDuocLieuOids.Clear();

        DuocLieuSearchText =
            string.Empty;

        if (IsEditMode)
        {
            Thuoc =
                objectSpace
                    .GetObjectByKey<DanhMucThuoc>(
                        Oid
                    );

            if (Thuoc == null)
            {
                ShowError(
                    "Không tìm thấy thuốc cần cập nhật."
                );

                return;
            }

            MaThuoc =
                Thuoc.MaThuoc ?? string.Empty;

            TenThuoc =
                Thuoc.TenThuoc ?? string.Empty;

            SelectedDvtOid =
                Thuoc.DonViTinh?.Oid ?? 0;

            SoLuongTon =
                Thuoc.SoLuongTon;

            SoLuongBoSung = 0;

            TonToiThieu =
                Thuoc.TonToiThieu;

            GiaBan =
                Thuoc.GiaBan;

            TuDongTinhGiaBan =
                Thuoc.TuDongTinhGiaBan;

            SuDungValue =
                Thuoc.SuDung
                    ? "true"
                    : "false";

            MoTa =
                Thuoc.MoTa ?? string.Empty;

            foreach (
                ThanhPhanThuoc thanhPhan
                in Thuoc.ThanhPhanThuocs
                    .Where(x =>
                        x.DuocLieu != null
                    )
                    .OrderBy(x =>
                        x.DuocLieu.TenDuocLieu
                    )
            )
            {
                ThanhPhanTam.Add(
                    CreateIngredientRow(
                        thanhPhan
                    )
                );
            }
        }
        else
        {
            Thuoc =
                objectSpace
                    .CreateObject<DanhMucThuoc>();

            MaThuoc = string.Empty;
            TenThuoc = string.Empty;

            SelectedDvtOid = 0;

            SoLuongTon = 0;
            SoLuongBoSung = 0;
            TonToiThieu = 0;
            GiaBan = 0;

            TuDongTinhGiaBan = true;
            SuDungValue = "true";

            MoTa = string.Empty;
        }
    }

    private MedicineIngredientRow
        CreateIngredientRow(
            ThanhPhanThuoc thanhPhan)
    {
        DuocLieu duocLieu =
            thanhPhan.DuocLieu;

        return new MedicineIngredientRow
        {
            ThanhPhanOid =
                thanhPhan.Oid,

            DuocLieuOid =
                duocLieu.Oid,

            MaDuocLieu =
                GetHerbCode(duocLieu),

            TenDuocLieu =
                duocLieu.TenDuocLieu ?? "--",

            DonViTinh =
                GetDvtName(duocLieu),

            TonKho =
                duocLieu.SoLuongTon,

            GiaNhap =
                duocLieu.GiaNhapGanNhat,

            SoLuong =
                thanhPhan.SoLuong,

            GhiChu =
                thanhPhan.GhiChu ??
                string.Empty
        };
    }

    private void OnDvtChanged(
        ChangeEventArgs e)
    {
        int.TryParse(
            e.Value?.ToString(),
            out SelectedDvtOid
        );
    }

    private bool IsHerbSelected(int oid)
    {
        return SelectedDuocLieuOids
            .Contains(oid);
    }

    private void ToggleHerbSelection(
        int oid,
        ChangeEventArgs e)
    {
        bool isChecked =
            GetCheckboxValue(e);

        if (isChecked)
        {
            SelectedDuocLieuOids.Add(oid);
        }
        else
        {
            SelectedDuocLieuOids.Remove(oid);
        }
    }

    private void ToggleAllVisibleHerbs(
        ChangeEventArgs e)
    {
        bool isChecked =
            GetCheckboxValue(e);

        List<int> visibleIds =
            DuocLieuDanhSachTick
                .Select(x => x.Oid)
                .ToList();

        if (isChecked)
        {
            foreach (int oid in visibleIds)
            {
                SelectedDuocLieuOids.Add(oid);
            }
        }
        else
        {
            foreach (int oid in visibleIds)
            {
                SelectedDuocLieuOids.Remove(oid);
            }
        }
    }

    private bool GetCheckboxValue(
        ChangeEventArgs e)
    {
        if (e.Value is bool boolValue)
            return boolValue;

        return bool.TryParse(
            e.Value?.ToString(),
            out bool parsed
        ) && parsed;
    }

    private void AddSelectedIngredients()
    {
        Message = string.Empty;

        if (SelectedDuocLieuOids.Count == 0)
        {
            ShowError(
                "Vui lòng tick chọn ít nhất một dược liệu."
            );

            return;
        }

        if (SoLuongMacDinhChoDuocLieu <= 0)
        {
            ShowError(
                "Số lượng mặc định phải lớn hơn 0."
            );

            return;
        }

        List<int> selectedIds =
            SelectedDuocLieuOids.ToList();

        foreach (int duocLieuOid in selectedIds)
        {
            bool daTonTai =
                ThanhPhanTam.Any(x =>
                    x.DuocLieuOid == duocLieuOid
                );

            if (daTonTai)
                continue;

            DuocLieu duocLieu =
                DanhSachDuocLieu
                    .FirstOrDefault(x =>
                        x.Oid == duocLieuOid
                    );

            if (duocLieu == null)
                continue;

            ThanhPhanTam.Add(
                new MedicineIngredientRow
                {
                    ThanhPhanOid = 0,

                    DuocLieuOid =
                        duocLieu.Oid,

                    MaDuocLieu =
                        GetHerbCode(duocLieu),

                    TenDuocLieu =
                        duocLieu.TenDuocLieu ??
                        "--",

                    DonViTinh =
                        GetDvtName(duocLieu),

                    TonKho =
                        duocLieu.SoLuongTon,

                    GiaNhap =
                        duocLieu.GiaNhapGanNhat,

                    SoLuong =
                        SoLuongMacDinhChoDuocLieu,

                    GhiChu =
                        GhiChuMacDinhChoDuocLieu
                            ?.Trim() ??
                        string.Empty
                }
            );
        }

        SelectedDuocLieuOids.Clear();

        SoLuongMacDinhChoDuocLieu = 1;

        GhiChuMacDinhChoDuocLieu =
            string.Empty;

        DuocLieuSearchText =
            string.Empty;
    }

    private void RemoveIngredient(
        MedicineIngredientRow item)
    {
        ThanhPhanTam.Remove(item);
    }

    private void ChangeIngredientQuantity(
        MedicineIngredientRow item,
        ChangeEventArgs e)
    {
        string value =
            e.Value?.ToString() ??
            string.Empty;

        if (TryParseDecimal(
            value,
            out decimal quantity))
        {
            item.SoLuong = quantity;
        }
        else
        {
            item.SoLuong = 0;
        }
    }

    private void ChangeIngredientNote(
        MedicineIngredientRow item,
        ChangeEventArgs e)
    {
        item.GhiChu =
            e.Value?.ToString() ??
            string.Empty;
    }

    private bool TryParseDecimal(
        string value,
        out decimal result)
    {
        if (decimal.TryParse(
            value,
            NumberStyles.Number,
            CultureInfo.InvariantCulture,
            out result))
        {
            return true;
        }

        return decimal.TryParse(
            value,
            NumberStyles.Number,
            CultureInfo.CurrentCulture,
            out result
        );
    }

    private bool ValidateForm()
    {
        Message = string.Empty;

        if (Thuoc == null)
        {
            ShowError(
                "Không có đối tượng thuốc để lưu."
            );

            return false;
        }

        if (string.IsNullOrWhiteSpace(
            TenThuoc))
        {
            ShowError(
                "Vui lòng nhập tên thuốc."
            );

            return false;
        }

        if (SelectedDvtOid <= 0)
        {
            ShowError(
                "Vui lòng chọn đơn vị tính cho thuốc."
            );

            return false;
        }

        if (SoLuongTon < 0 ||
            SoLuongBoSung < 0 ||
            TonToiThieu < 0)
        {
            ShowError(
                "Số lượng và tồn tối thiểu không được nhỏ hơn 0."
            );

            return false;
        }

        if (!TuDongTinhGiaBan &&
            GiaBan < 0)
        {
            ShowError(
                "Giá bán không được nhỏ hơn 0."
            );

            return false;
        }

        string normalizedCode =
            MaThuoc?.Trim() ??
            string.Empty;

        if (!string.IsNullOrWhiteSpace(
            normalizedCode))
        {
            bool trungMa =
                objectSpace
                    .GetObjects<DanhMucThuoc>()
                    .Any(x =>
                        x != Thuoc &&

                        string.Equals(
                            x.MaThuoc?.Trim(),
                            normalizedCode,
                            StringComparison
                                .OrdinalIgnoreCase
                        )
                    );

            if (trungMa)
            {
                ShowError(
                    $"Mã thuốc \"{normalizedCode}\" đã tồn tại."
                );

                return false;
            }
        }

        foreach (
            MedicineIngredientRow item
            in ThanhPhanTam)
        {
            if (item.DuocLieuOid <= 0)
            {
                ShowError(
                    "Có thành phần chưa chọn dược liệu."
                );

                return false;
            }

            if (item.SoLuong <= 0)
            {
                ShowError(
                    $"Số lượng của dược liệu " +
                    $"\"{item.TenDuocLieu}\" " +
                    "phải lớn hơn 0."
                );

                return false;
            }
        }

        if (SoLuongCanTaoLanNay > 0 &&
            !ThanhPhanTam.Any())
        {
            ShowError(
                "Vui lòng khai báo thành phần dược liệu " +
                "trước khi tạo tồn thuốc."
            );

            return false;
        }

        return ValidateHerbStock();
    }

    private bool ValidateHerbStock()
    {
        if (SoLuongCanTaoLanNay <= 0)
            return true;

        var groups =
            ThanhPhanTam
                .GroupBy(x =>
                    x.DuocLieuOid
                )
                .Select(x => new
                {
                    DuocLieuOid =
                        x.Key,

                    SoLuongCanDung =
                        x.Sum(y =>
                            y.SoLuong
                        ) *
                        SoLuongCanTaoLanNay
                })
                .ToList();

        foreach (var group in groups)
        {
            DuocLieu duocLieu =
                objectSpace
                    .GetObjectByKey<DuocLieu>(
                        group.DuocLieuOid
                    );

            if (duocLieu == null)
            {
                ShowError(
                    "Có dược liệu không còn tồn tại trong hệ thống."
                );

                return false;
            }

            if (duocLieu.SoLuongTon <
                group.SoLuongCanDung)
            {
                ShowError(
                    $"Dược liệu \"{duocLieu.TenDuocLieu}\" " +
                    $"không đủ tồn kho. Cần " +
                    $"{FormatQuantity(group.SoLuongCanDung)} " +
                    $"{GetDvtName(duocLieu)}, hiện còn " +
                    $"{FormatQuantity(duocLieu.SoLuongTon)} " +
                    $"{GetDvtName(duocLieu)}."
                );

                return false;
            }
        }

        return true;
    }

    private void SaveMedicine()
    {
        if (IsSaving)
            return;

        IsSaving = true;

        try
        {
            if (!ValidateForm())
                return;

            ListDvt donViTinh =
                objectSpace
                    .GetObjectByKey<ListDvt>(
                        SelectedDvtOid
                    );

            if (donViTinh == null)
            {
                ShowError(
                    "Đơn vị tính của thuốc không tồn tại."
                );

                return;
            }

            Thuoc.MaThuoc =
                string.IsNullOrWhiteSpace(
                    MaThuoc)
                    ? null
                    : MaThuoc.Trim();

            Thuoc.TenThuoc =
                TenThuoc.Trim();

            Thuoc.DonViTinh =
                donViTinh;

            Thuoc.TonToiThieu =
                TonToiThieu;

            Thuoc.TuDongTinhGiaBan =
                TuDongTinhGiaBan;

            Thuoc.GiaBan =
                TuDongTinhGiaBan
                    ? GiaTinhTuDuocLieu
                    : GiaBan;

            Thuoc.SuDung =
                SuDungValue == "true";

            Thuoc.MoTa =
                string.IsNullOrWhiteSpace(
                    MoTa)
                    ? null
                    : MoTa.Trim();

            SyncIngredients();

            if (IsEditMode)
            {
                if (SoLuongBoSung > 0)
                {
                    DeductHerbStock(
                        SoLuongBoSung
                    );

                    Thuoc.SoLuongTon +=
                        SoLuongBoSung;
                }
            }
            else
            {
                Thuoc.SoLuongTon =
                    SoLuongTon;

                if (SoLuongTon > 0)
                {
                    DeductHerbStock(
                        SoLuongTon
                    );

                    Thuoc.DaTruDuocLieuKhiTao =
                        true;
                }
            }

            objectSpace.CommitChanges();

            Navigation.NavigateTo(
                "/staff/medicines"
            );
        }
        catch (Exception ex)
        {
            ShowError(
                "Không thể lưu thuốc: " +
                GetErrorMessage(ex)
            );
        }
        finally
        {
            IsSaving = false;
        }
    }

    private void SyncIngredients()
    {
        List<ThanhPhanThuoc> existingItems =
            Thuoc.ThanhPhanThuocs
                .ToList();

        HashSet<int> retainedIds =
            ThanhPhanTam
                .Where(x =>
                    x.ThanhPhanOid > 0
                )
                .Select(x =>
                    x.ThanhPhanOid
                )
                .ToHashSet();

        foreach (
            ThanhPhanThuoc existing
            in existingItems)
        {
            if (!retainedIds.Contains(
                existing.Oid))
            {
                objectSpace.Delete(
                    existing
                );
            }
        }

        foreach (
            MedicineIngredientRow row
            in ThanhPhanTam)
        {
            ThanhPhanThuoc thanhPhan;

            if (row.ThanhPhanOid > 0)
            {
                thanhPhan =
                    objectSpace
                        .GetObjectByKey<ThanhPhanThuoc>(
                            row.ThanhPhanOid
                        );
            }
            else
            {
                thanhPhan =
                    objectSpace
                        .CreateObject<ThanhPhanThuoc>();
            }

            if (thanhPhan == null)
            {
                throw new InvalidOperationException(
                    $"Không thể cập nhật thành phần " +
                    $"\"{row.TenDuocLieu}\"."
                );
            }

            DuocLieu duocLieu =
                objectSpace
                    .GetObjectByKey<DuocLieu>(
                        row.DuocLieuOid
                    );

            if (duocLieu == null)
            {
                throw new InvalidOperationException(
                    $"Không tìm thấy dược liệu " +
                    $"\"{row.TenDuocLieu}\"."
                );
            }

            thanhPhan.Thuoc =
                Thuoc;

            thanhPhan.DuocLieu =
                duocLieu;

            thanhPhan.DonViTinh =
                duocLieu.DonViTinh;

            thanhPhan.SoLuong =
                row.SoLuong;

            thanhPhan.GhiChu =
                string.IsNullOrWhiteSpace(
                    row.GhiChu)
                    ? null
                    : row.GhiChu.Trim();

            thanhPhan.CapNhatThanhTien();
        }
    }

    private void DeductHerbStock(
        decimal soLuongThuocCanTao)
    {
        var groups =
            ThanhPhanTam
                .GroupBy(x =>
                    x.DuocLieuOid
                )
                .Select(x => new
                {
                    DuocLieuOid =
                        x.Key,

                    SoLuongCanDung =
                        x.Sum(y =>
                            y.SoLuong
                        ) *
                        soLuongThuocCanTao
                })
                .ToList();

        foreach (var group in groups)
        {
            DuocLieu duocLieu =
                objectSpace
                    .GetObjectByKey<DuocLieu>(
                        group.DuocLieuOid
                    );

            if (duocLieu == null)
            {
                throw new InvalidOperationException(
                    "Không tìm thấy dược liệu cần trừ kho."
                );
            }

            if (duocLieu.SoLuongTon <
                group.SoLuongCanDung)
            {
                throw new InvalidOperationException(
                    $"Dược liệu \"{duocLieu.TenDuocLieu}\" " +
                    "không đủ tồn kho."
                );
            }

            duocLieu.SoLuongTon -=
                group.SoLuongCanDung;
        }
    }

    private decimal GetRequiredQuantity(
        MedicineIngredientRow item)
    {
        return
            item.SoLuong *
            SoLuongCanTaoLanNay;
    }

    private string GetRequiredStockClass(
        MedicineIngredientRow item)
    {
        return
            GetRequiredQuantity(item) >
            item.TonKho
                ? "medicine-stock-insufficient"
                : "medicine-stock-sufficient";
    }

    private string GetHerbCode(
        DuocLieu duocLieu)
    {
        if (duocLieu == null)
            return "--";

        if (!string.IsNullOrWhiteSpace(
            duocLieu.MaDuocLieu))
        {
            return duocLieu.MaDuocLieu;
        }

        return $"DL-{duocLieu.Oid:0000}";
    }

    private string GetDvtName(
        DuocLieu duocLieu)
    {
        return
            duocLieu?.DonViTinh?.TenDvt ??
            "--";
    }

    private string GetChecklistStockClass(
        DuocLieu duocLieu)
    {
        if (duocLieu == null ||
            duocLieu.SoLuongTon <= 0)
        {
            return
                "medicine-herb-stock danger";
        }

        if (duocLieu.SoLuongTon <=
            duocLieu.TonToiThieu)
        {
            return
                "medicine-herb-stock warning";
        }

        return
            "medicine-herb-stock success";
    }

    private string EmptyText(string value)
    {
        return
            string.IsNullOrWhiteSpace(value)
                ? "--"
                : value;
    }

    private string GetErrorMessage(
        Exception ex)
    {
        Exception current = ex;

        while (
            current.InnerException != null &&
            !string.IsNullOrWhiteSpace(
                current.InnerException.Message))
        {
            current =
                current.InnerException;
        }

        return current.Message;
    }

    private void ShowError(string message)
    {
        MessageClass =
            "mf-alert mf-alert-danger";

        Message = message;
    }

    private string FormatMoney(
        decimal value)
    {
        return
            value.ToString("n0") +
            " đ";
    }

    private string FormatQuantity(
        decimal value)
    {
        return value.ToString("0.##");
    }

    private string ToInvariant(
        decimal value)
    {
        return value.ToString(
            CultureInfo.InvariantCulture
        );
    }

    private void GoMedicines()
    {
        Navigation.NavigateTo(
            "/staff/medicines"
        );
    }

    public void Dispose()
    {
        objectSpace?.Dispose();
    }

