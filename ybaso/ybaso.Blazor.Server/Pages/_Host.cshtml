@page "/"
@namespace ybaso.Blazor.Server
@using DevExpress.ExpressApp.Blazor.Components
@using Microsoft.AspNetCore.Mvc.Rendering

<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width,
    initial-scale=1.0,
    shrink-to-fit=no" />

    <meta name="mobile-web-app-capable"
          content="yes" />

    <title>MediFlow</title>

    <base href="/" />

    @(await Html.RenderComponentAsync<BootstrapThemeLink>(
        RenderMode.Static
    ))

    <link href="_content/DevExpress.ExpressApp.Blazor/styles.css"
          rel="stylesheet" />

    <link href="css/mediflow-core.css"
          rel="stylesheet" />

    <link href="css/roles/admin.css"
          rel="stylesheet" />

    <link href="css/roles/doctor.css"
          rel="stylesheet" />

    

    <link href="css/natcare-pos-checkout.css?v=20260715-01"
          rel="stylesheet" />

    <link href="css/roles/patient.css"
          rel="stylesheet" />

    <link href="/css/roles/login.css?v=20260715-08"
          rel="stylesheet" />

    <link href="css/mediflow-modern.css?v=20260717-01"
          rel="stylesheet" />

    <link href="css/role-sidebar.css?v=20260717-01"
          rel="stylesheet" />

    <!-- Staff CSS phải được tải cuối cùng để không bị ghi đè -->
    <link href="css/roles/staff.css?v=20260726-05"
          rel="stylesheet" />
</head>

<body>
    @(await Html.RenderComponentAsync<SplashScreen>(
        RenderMode.Static,
        new
        {
            Caption = "MediFlow",
            ImagePath = "images/SplashScreen.svg"
        }
    ))

    <app class="d-none">
        @(await Html.RenderComponentAsync<App>(
            RenderMode.Server
        ))
    </app>

    @(await Html.RenderComponentAsync<AlertsHandler>(
        RenderMode.Server
    ))

    <div id="blazor-error-ui">
        @(await Html.RenderComponentAsync<BlazorError>(
            RenderMode.Static
        ))
    </div>

    <script src="_framework/blazor.server.js"></script>

    <script src="/js/mediflow-ui.js?v=20260715-02"></script>
</body>

</html>
</html>