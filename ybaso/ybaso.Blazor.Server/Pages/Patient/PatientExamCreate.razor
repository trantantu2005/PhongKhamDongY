                                        <span>☯️</span>
                                    </div>

                                    @if (CurrentExam.NguTaTuDongs.Any())
                                    {
                                        <div class="patient-selfexam-table-wrap">
                                            <table class="patient-selfexam-result-table">
                                                <thead>
                                                    <tr>
                                                        <th>Trái</th>
                                                        <th>Giữa</th>
                                                        <th>Phải</th>
                                                        <th>Kết quả</th>
                                                    </tr>
                                                </thead>

                                                <tbody>
                                                    @foreach (
                                                        CakhamNguTaTuDong item
                                                        in CurrentExam
                                                            .NguTaTuDongs
                                                            .OrderBy(x => x.TT))
                                                    {
                                                        <tr>
                                                            <td>@item.CotTrai</td>
                                                            <td>@item.CotGiua</td>
                                                            <td>@item.CotPhai</td>
                                                            <td>
                                                                <strong>@item.KetQua</strong>
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="patient-selfexam-result-empty">
                                            Chưa có dữ liệu ngũ tà.
                                        </div>
                                    }
                                </article>

                                <article class="patient-selfexam-result-card">
                                    <div class="patient-selfexam-result-head">
                                        <div>
                                            <h3>Bệnh chứng gợi ý</h3>
                                            <p>
                                                Các bệnh chứng phù hợp
                                                với kết quả đo.
                                            </p>
                                        </div>

                                        <span>📋</span>
                                    </div>

                                    @if (CurrentExam.BenhChungTuDongs.Any())
                                    {
                                        <div class="patient-selfexam-table-wrap">
                                            <table class="patient-selfexam-result-table">
                                                <thead>
                                                    <tr>
                                                        <th>Bệnh chứng</th>
                                                        <th>Triệu chứng</th>
                                                    </tr>
                                                </thead>

                                                <tbody>
                                                    @foreach (
                                                        CakhamBenhChungTuDong item
                                                        in CurrentExam
                                                            .BenhChungTuDongs
                                                            .OrderBy(x => x.TenBenhChung))
                                                    {
                                                        <tr>
                                                            <td>
                                                                <strong>
                                                                    @item.TenBenhChung
                                                                </strong>
                                                            </td>

                                                            <td class="patient-selfexam-multiline">
                                                                @item.TrieuChung
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="patient-selfexam-result-empty">
                                            Chưa tìm thấy bệnh chứng phù hợp.
                                        </div>
                                    }
                                </article>

                                <article class="patient-selfexam-result-card">
                                    <div class="patient-selfexam-result-head">
                                        <div>
                                            <h3>Pháp trị gợi ý</h3>
                                            <p>
                                                Phương pháp điều trị,
                                                phương dược và huyệt gợi ý.
                                            </p>
                                        </div>

                                        <span>🌿</span>
                                    </div>

                                    @if (CurrentExam.PhapTriTuDongs.Any())
                                    {
                                        <div class="patient-selfexam-table-wrap">
                                            <table class="patient-selfexam-result-table patient-selfexam-wide-table">
                                                <thead>
                                                    <tr>
                                                        <th>Bệnh chứng</th>
                                                        <th>Huyệt</th>
                                                        <th>Pháp điều trị</th>
                                                        <th>Phương dược</th>
                                                    </tr>
                                                </thead>

                                                <tbody>
                                                    @foreach (
                                                        CakhamPhapTriTuDong item
                                                        in CurrentExam
                                                            .PhapTriTuDongs
                                                            .OrderBy(x => x.BenhChung))
                                                    {
                                                        <tr>
                                                            <td>
                                                                <strong>
                                                                    @item.BenhChung
                                                                </strong>
                                                            </td>

                                                            <td class="patient-selfexam-multiline">
                                                                @item.Huyet
                                                            </td>

                                                            <td class="patient-selfexam-multiline">
                                                                @item.PhapDieuTri
                                                            </td>

                                                            <td class="patient-selfexam-multiline">
                                                                @item.PhuongDuoc
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="patient-selfexam-result-empty">
                                            Chưa có pháp trị phù hợp.
                                        </div>
                                    }
                                </article>

                                <div class="patient-selfexam-result-actions">
                                    <button class="patient-btn patient-btn-outline"
                                            type="button"
                                            @onclick="GoExamHistory">
                                        Xem lịch sử khám
                                    </button>

                                    <button class="patient-btn patient-btn-primary"
                                            type="button"
                                            @onclick="GoExamDetail">
                                        Xem chi tiết ca khám
                                    </button>
                                </div>
                            }
                        </section>
                    }
                </div>
            </section>
        }
    </main>
</div>

@code {
    [Parameter]
    public int Oid { get; set; }

    private IObjectSpace objectSpace;

    private Benhnhan CurrentPatient;

    private Cakham CurrentExam;

    private readonly List<MeasurementRowModel>
        MeasurementRows = new();

    private string CurrentUserName =
        "Bệnh nhân";

    private string ErrorMessage =
        string.Empty;

    private string ActionMessage =
        string.Empty;

    private string ActionMessageClass =
        "patient-action-message success";

    private string ActiveTab =
        "info";

    private string Reason =
        string.Empty;

    private double Height;

    private double Weight;

    private double EnvironmentTemperature =
        26.3;

    private bool IsLoading = true;

    private bool IsProcessing;

    private int LoadedOid = -1;

    private string SidebarName =>
        CurrentPatient?.HoTen
        ?? CurrentUserName;

    private bool CanEditExam =>
        CurrentExam != null &&
        CurrentExam.TrangThai ==
            TrangThaiCaKham.ChoKham;

    private string ExamTitle =>
        CurrentExam == null
            ? "Ca khám"
            : $"{CurrentPatient?.HoTen} - " +
              $"{CurrentExam.NgayCT:dd/MM/yyyy HH:mm}";

    private string BmiText
    {
        get
        {
            if (Height <= 0 ||
                Weight <= 0)
            {
                return "--";
            }

            double heightMeter =
                Height / 100d;

            double bmi =
                Weight /
                (heightMeter * heightMeter);

            return bmi.ToString("0.0");
        }
    }

    private IEnumerable<MeasurementRowModel>
        UpperMeasurements =>
            MeasurementRows
                .Where(x => x.TT <= 6)
                .OrderBy(x => x.TT);

    private IEnumerable<MeasurementRowModel>
        LowerMeasurements =>
            MeasurementRows
                .Where(x => x.TT >= 7)
                .OrderBy(x => x.TT);

    private bool HasAnalysisResult =>
        CurrentExam != null &&
        (
            !string.IsNullOrWhiteSpace(
                CurrentExam.Amduong) ||

            !string.IsNullOrWhiteSpace(
                CurrentExam.Huthuc) ||

            !string.IsNullOrWhiteSpace(
                CurrentExam.Khihuyet) ||

            CurrentExam.ChanDoanTuDongs.Any() ||

            CurrentExam.BenhChungTuDongs.Any() ||

            CurrentExam.PhapTriTuDongs.Any()
        );

    protected override async Task OnParametersSetAsync()
    {
        await LoadPageData();
    }

    private async Task LoadPageData()
    {
        IsLoading = true;
        ErrorMessage = string.Empty;

        bool routeChanged =
            LoadedOid != Oid;

        try
        {
            objectSpace?.Dispose();

            objectSpace =
                ObjectSpaceFactory.CreateObjectSpace(
                    typeof(Cakham)
                );

            CurrentUserName =
                await CurrentPatientService
                    .GetCurrentUserNameAsync();

            CurrentPatient =
                await CurrentPatientService
                    .GetCurrentPatientAsync(
                        objectSpace
                    );

            if (CurrentPatient == null)
            {
                CurrentExam = null;
                MeasurementRows.Clear();
                return;
            }

            if (Oid <= 0)
            {
                CurrentExam = null;

                Height = 0;
                Weight = 0;
                EnvironmentTemperature = 26.3;
                Reason = string.Empty;

                CreateDefaultMeasurementModels();

                ActiveTab = "info";
                LoadedOid = Oid;

                return;
            }

            CurrentExam =
                await CurrentPatientService
                    .GetOwnedExamAsync(
                        objectSpace,
                        Oid
                    );

            if (CurrentExam == null)
            {
                MeasurementRows.Clear();
                return;
            }

            LoadFieldsFromExam();
            LoadMeasurementsFromExam();

            if (routeChanged)
            {
                ActiveTab =
                    HasAnalysisResult
                        ? "results"
                        : "measurements";
            }

            LoadedOid = Oid;
        }
        catch (Exception ex)
        {
            CurrentExam = null;
            MeasurementRows.Clear();

            ErrorMessage =
                "Đã xảy ra lỗi khi tải ca khám. " +
                GetErrorMessage(ex);
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void LoadFieldsFromExam()
    {
        if (CurrentExam == null)
        {
            return;
        }

        Height =
            CurrentExam.Chieucao;

        Weight =
            CurrentExam.Cannang;

        EnvironmentTemperature =
            CurrentExam.NhietDoMoiTruong;

        Reason =
            CurrentExam.LydoKham
            ?? string.Empty;
    }

    private void LoadMeasurementsFromExam()
    {
        MeasurementRows.Clear();

        if (CurrentExam == null)
        {
            CreateDefaultMeasurementModels();
            return;
        }

        foreach (
            CakhamSoDoChiTiet item
            in CurrentExam
                .SoDoChiTiets
                .OrderBy(x => x.TT))
        {
            MeasurementRows.Add(
                new MeasurementRowModel
                {
                    TT = item.TT,
                    TinhHuyet =
                        item.TinhHuyet
                        ?? $"Huyệt {item.TT}",
                    NhomChi =
                        item.NhomChi ==
                            NhomChiDo.ChiTren
                                ? "Chi trên"
                                : "Chi dưới",
                    Trai = item.Trai,
                    Phai = item.Phai
                }
            );
        }

        if (MeasurementRows.Count != 12)
        {
            MergeMissingMeasurementModels();
        }
    }

    private void CreateDefaultMeasurementModels()
    {
        MeasurementRows.Clear();

        foreach (
            MeasurementRowModel item
            in GetDefaultMeasurements())
        {
            MeasurementRows.Add(item);
        }
    }

    private void MergeMissingMeasurementModels()
    {
        foreach (
            MeasurementRowModel defaultItem
            in GetDefaultMeasurements())
        {
            bool exists =
                MeasurementRows.Any(x =>
                    x.TT == defaultItem.TT
                );

            if (!exists)
            {
                MeasurementRows.Add(defaultItem);
            }
        }

        MeasurementRows.Sort(
            (left, right) =>
                left.TT.CompareTo(right.TT)
        );
    }

    private static List<MeasurementRowModel>
        GetDefaultMeasurements()
    {
        return new List<MeasurementRowModel>
        {
            NewMeasurement(1, "Tiểu", "Chi trên"),
            NewMeasurement(2, "Tâm", "Chi trên"),
            NewMeasurement(3, "Tam", "Chi trên"),
            NewMeasurement(4, "Bào", "Chi trên"),
            NewMeasurement(5, "Đại", "Chi trên"),
            NewMeasurement(6, "Phế", "Chi trên"),

            NewMeasurement(7, "Bàng", "Chi dưới"),
            NewMeasurement(8, "Thận", "Chi dưới"),
            NewMeasurement(9, "Đảm", "Chi dưới"),
            NewMeasurement(10, "Vị", "Chi dưới"),
            NewMeasurement(11, "Can", "Chi dưới"),
            NewMeasurement(12, "Tỳ", "Chi dưới")
        };
    }

    private static MeasurementRowModel
        NewMeasurement(
            int tt,
            string name,
            string group)
    {
        return new MeasurementRowModel
        {
            TT = tt,
            TinhHuyet = name,
            NhomChi = group
        };
    }

    private async Task CreateExam()
    {
        if (IsProcessing)
        {
            return;
        }

        IsProcessing = true;
        ActionMessage = string.Empty;

        try
        {
            int examOid =
                await PatientSelfExamService
                    .CreateExamAsync(
                        Reason,
                        Height,
                        Weight,
                        EnvironmentTemperature
                    );

            Navigation.NavigateTo(
                $"/patient/exams/self/{examOid}"
            );
        }
        catch (Exception ex)
        {
            ShowError(
                GetErrorMessage(ex)
            );
        }
        finally
        {
            IsProcessing = false;
        }
    }

    private async Task SaveExamInformation()
    {
        if (IsProcessing ||
            CurrentExam == null)
        {
            return;
        }

        IsProcessing = true;
        ActionMessage = string.Empty;

        try
        {
            await PatientSelfExamService
                .UpdateExamInformationAsync(
                    CurrentExam.Oid,
                    Reason,
                    Height,
                    Weight,
                    EnvironmentTemperature
                );

            await ReloadOwnedExam();

            ShowSuccess(
                "Đã lưu thông tin ca khám thành công."
            );
        }
        catch (Exception ex)
        {
            ShowError(
                GetErrorMessage(ex)
            );
        }
        finally
        {
            IsProcessing = false;
        }
    }

    private async Task SaveMeasurements()
    {
        if (IsProcessing ||
            CurrentExam == null)
        {
            return;
        }

        IsProcessing = true;
        ActionMessage = string.Empty;

        try
        {
            await SaveMeasurementData();

            await ReloadOwnedExam();

            ShowSuccess(
                "Đã lưu đầy đủ 12 cặp số đo."
            );
        }
        catch (Exception ex)
        {
            ShowError(
                GetErrorMessage(ex)
            );
        }
        finally
        {
            IsProcessing = false;
        }
    }

    private async Task AnalyzeMeasurements()
    {
        if (IsProcessing ||
            CurrentExam == null)
        {
            return;
        }

        IsProcessing = true;
        ActionMessage = string.Empty;

        try
        {
            await SaveMeasurementData();

            await PatientSelfExamService
                .AnalyzeExamAsync(
                    CurrentExam.Oid
                );

            await ReloadOwnedExam();

            ActiveTab = "results";

            ShowSuccess(
                "Đã phân tích số đo. " +
                "Kết quả đang chờ bác sĩ kiểm tra."
            );
        }
        catch (Exception ex)
        {
            ShowError(
                GetErrorMessage(ex)
            );
        }
        finally
        {
            IsProcessing = false;
        }
    }

    private async Task SaveMeasurementData()
    {
        List<PatientExamMeasurementInput> inputs =
            MeasurementRows
                .OrderBy(x => x.TT)
                .Select(x =>
                    new PatientExamMeasurementInput
                    {
                        TT = x.TT,
                        Trai = x.Trai,
                        Phai = x.Phai
                    }
                )
                .ToList();

        await PatientSelfExamService
            .SaveMeasurementsAsync(
                CurrentExam.Oid,
                inputs
            );
    }

    private async Task ReloadOwnedExam()
    {
        objectSpace?.Dispose();

        objectSpace =
            ObjectSpaceFactory.CreateObjectSpace(
                typeof(Cakham)
            );

        CurrentPatient =
            await CurrentPatientService
                .GetCurrentPatientAsync(
                    objectSpace
                );

        CurrentExam =
            await CurrentPatientService
                .GetOwnedExamAsync(
                    objectSpace,
                    Oid
                );

        LoadFieldsFromExam();
        LoadMeasurementsFromExam();
    }

    private async Task ReloadPage()
    {
        ActionMessage = string.Empty;
        await LoadPageData();
    }

    private void SetTab(string tab)
    {
        ActiveTab = tab;
        ActionMessage = string.Empty;
    }

    private string GetTabClass(string tab)
    {
        return ActiveTab == tab
            ? "patient-selfexam-tab active"
            : "patient-selfexam-tab";
    }

    private void ShowSuccess(string message)
    {
        ActionMessageClass =
            "patient-action-message success";

        ActionMessage = message;
    }

    private void ShowError(string message)
    {
        ActionMessageClass =
            "patient-action-message error";

        ActionMessage = message;
    }

    private void GoHome()
    {
        Navigation.NavigateTo("/patient");
    }

    private void GoCreateNewExam()
    {
        Navigation.NavigateTo(
            "/patient/exams/new"
        );
    }

    private void GoExamHistory()
    {
        Navigation.NavigateTo(
            "/patient/exams"
        );
    }

    private void GoExamDetail()
    {
        if (CurrentExam == null)
        {
            return;
        }

        Navigation.NavigateTo(
            $"/patient/exams/{CurrentExam.Oid}"
        );
    }

    private string ExamStatusText(
        TrangThaiCaKham status)
    {
        return status switch
        {
            TrangThaiCaKham.ChoKham =>
                "Chờ bác sĩ",

            TrangThaiCaKham.DangKham =>
                "Đang khám",

            TrangThaiCaKham.DaKham =>
                "Đã hoàn thành",

            TrangThaiCaKham.DaHuy =>
                "Đã hủy",

            _ => status.ToString()
        };
    }

    private string ExamStatusClass(
        TrangThaiCaKham status)
    {
        return status switch
        {
            TrangThaiCaKham.ChoKham =>
                "patient-status warning",

            TrangThaiCaKham.DangKham =>
                "patient-status info",

            TrangThaiCaKham.DaKham =>
                "patient-status success",

            TrangThaiCaKham.DaHuy =>
                "patient-status danger",

            _ => "patient-status neutral"
        };
    }

    private string GenderText(int gender)
    {
        return gender switch
        {
            1 => "Nam",
            2 => "Nữ",
            _ => "Chưa cập nhật giới tính"
        };
    }

    private string AgeText(DateTime birthDate)
    {
        if (birthDate == DateTime.MinValue)
        {
            return "Chưa cập nhật ngày sinh";
        }

        DateTime today =
            DateTime.Today;

        int age =
            today.Year -
            birthDate.Year;

        if (birthDate.Date >
            today.AddYears(-age))
        {
            age--;
        }

        return $"{Math.Max(age, 0)} tuổi";
    }

    private string EmptyText(string value)
    {
        return string.IsNullOrWhiteSpace(value)
            ? "Chưa có kết quả"
            : value;
    }

    private string Text(string value)
    {
        return string.IsNullOrWhiteSpace(value)
            ? "Chưa cập nhật"
            : value;
    }

    private string GetInitials(string fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName))
        {
            return "BN";
        }

        string[] parts =
            fullName.Split(
                ' ',
                StringSplitOptions.RemoveEmptyEntries
            );

        if (parts.Length == 0)
        {
            return "BN";
        }

        if (parts.Length == 1)
        {
            return parts[0]
                .Substring(
                    0,
                    Math.Min(2, parts[0].Length)
                )
                .ToUpperInvariant();
        }

        return $"{parts[0][0]}{parts[^1][0]}"
            .ToUpperInvariant();
    }

    private string GetErrorMessage(
        Exception exception)
    {
        Exception current =
            exception;

        while (
            current.InnerException != null &&
            !string.IsNullOrWhiteSpace(
                current.InnerException.Message
            )
        )
        {
            current =
                current.InnerException;
        }

        return current.Message;
    }

    public void Dispose()
    {
        objectSpace?.Dispose();
    }

    private sealed class MeasurementRowModel
    {
        public int TT { get; set; }

        public string TinhHuyet { get; set; } =
            string.Empty;

        public string NhomChi { get; set; } =
            string.Empty;

        public double Trai { get; set; }

        public double Phai { get; set; }

        public double Average =>
            Trai <= 0 && Phai <= 0
                ? 0
                : (Trai + Phai) / 2d;
    }
}