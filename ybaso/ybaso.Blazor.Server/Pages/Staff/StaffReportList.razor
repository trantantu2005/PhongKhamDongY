    {
        if (item?.BenhNhan != null &&
            !string.IsNullOrWhiteSpace(
                item.BenhNhan.Dienthoai))
        {
            return item.BenhNhan.Dienthoai;
        }

        return Text(
            item?.DienThoaiBenhNhan
        );
    }

