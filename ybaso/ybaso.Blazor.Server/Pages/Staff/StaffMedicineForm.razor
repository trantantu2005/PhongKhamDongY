@page "/staff/medicines/new"
@page "/staff/medicines/edit/{Oid:int}"

@using System.Globalization
@using System.Linq
@using DevExpress.ExpressApp
@using ybaso.Module.BusinessObjects
@implements IDisposable

@inject IObjectSpaceFactory ObjectSpaceFactory
@inject NavigationManager Navigation

<div class="staff-page">
    <StaffSidebar ActiveMenu="medicines" />

    <main class="staff-main">
        <header class="mf-topbar">
            <div>
                <h1>@PageTitle</h1>

                <p>
                    Khai báo thông tin thuốc, chọn nhiều dược liệu cùng lúc
                    và thiết lập định lượng cho từng thành phần.
                </p>
            </div>

            <div class="mf-actions">
                <button class="mf-btn mf-btn-outline"
                        type="button"
                        @onclick="GoMedicines">
                    ← Quay lại
                </button>

                <button class="mf-btn mf-btn-primary"
                        type="button"
                        disabled="@IsSaving"
                        @onclick="SaveMedicine">
                    @(IsSaving ? "Đang lưu..." : "💾 Lưu thuốc")
                </button>
            </div>
        </header>

        @if (!string.IsNullOrWhiteSpace(Message))
        {
            <div class="@MessageClass">
                @Message
            </div>
        }

        <!-- THÔNG TIN THUỐC -->
        <section class="staff-form-card">
            <div class="staff-form-header">
                <div class="staff-form-avatar">
                    💊
                </div>

                <div>
                    <h2>@PreviewName</h2>
                    <p>@PreviewSubtitle</p>
                </div>
            </div>

            <div class="staff-form-grid">
                <div class="staff-form-group">
                    <label>Mã thuốc</label>

                    <input class="staff-form-control"
                           placeholder="VD: TH001"
                           @bind="MaThuoc" />
                </div>

                <div class="staff-form-group">
                    <label>
                        Tên thuốc
                        <span class="required">*</span>
                    </label>

                    <input class="staff-form-control"
                           placeholder="VD: Thang bổ khí huyết..."
                           @bind="TenThuoc" />
                </div>

                <div class="staff-form-group">
                    <label>
                        Đơn vị tính
                        <span class="required">*</span>
                    </label>

                    <select class="staff-form-control"
                            value="@SelectedDvtOid"
                            @onchange="OnDvtChanged">

                        <option value="0">
                            -- Chọn đơn vị tính --
                        </option>

                        @foreach (ListDvt dvt in DanhSachDvt)
                        {
                            <option value="@dvt.Oid">
                                @dvt.TenDvt
                            </option>
                        }
                    </select>
                </div>

                @if (IsEditMode)
                {
                    <div class="staff-form-group">
                        <label>Tồn thuốc hiện tại</label>

                        <input class="staff-form-control"
                               type="number"
                               value="@ToInvariant(SoLuongTon)"
                               disabled />

                        <small class="medicine-field-note">
                            Không chỉnh trực tiếp để tránh trừ dược liệu lặp lại.
                        </small>
                    </div>

                    <div class="staff-form-group">
                        <label>Số lượng thuốc bổ sung</label>

                        <input class="staff-form-control"
                               type="number"
                               min="0"
                               step="1"
                               @bind="SoLuongBoSung" />

                        <small class="medicine-field-note">
                            Kho dược liệu chỉ bị trừ theo số lượng bổ sung này.
                        </small>
                    </div>
                }
                else
                {
                    <div class="staff-form-group">
                        <label>Số lượng tạo ban đầu</label>

                        <input class="staff-form-control"
                               type="number"
                               min="0"
                               step="1"
                               @bind="SoLuongTon" />

                        <small class="medicine-field-note">
                            Nhập số lượng thuốc hoặc thang thuốc muốn tạo ngay.
                        </small>
                    </div>
                }

                <div class="staff-form-group">
                    <label>Tồn tối thiểu</label>

                    <input class="staff-form-control"
                           type="number"
                           min="0"
                           step="1"
                           @bind="TonToiThieu" />
                </div>

                <div class="staff-form-group">
                    <label>Giá bán</label>

                    @if (TuDongTinhGiaBan)
                    {
                        <input class="staff-form-control"
                               type="number"
                               value="@ToInvariant(GiaTinhTuDuocLieu)"
                               disabled />

                        <small class="medicine-field-note">
                            Được tính từ giá nhập và định lượng các dược liệu.
                        </small>
                    }
                    else
                    {
                        <input class="staff-form-control"
                               type="number"
                               min="0"
                               step="1000"
                               @bind="GiaBan" />
                    }
                </div>

                <div class="staff-form-group">
                    <label>Sử dụng</label>

                    <select class="staff-form-control"
                            @bind="SuDungValue">

                        <option value="true">
                            Đang dùng
                        </option>

                        <option value="false">
                            Ngừng dùng
                        </option>
                    </select>
                </div>

                <div class="staff-form-group">
                    <label>Cách tính giá bán</label>

                    <label class="medicine-checkbox">
                        <input type="checkbox"
                               @bind="TuDongTinhGiaBan" />

                        <span>
                            Tự động tính từ thành phần dược liệu
                        </span>
                    </label>
                </div>

                <div class="staff-form-group full">
                    <label>Mô tả</label>

                    <textarea class="staff-form-control"
                              placeholder="Nhập công dụng, cách dùng hoặc ghi chú..."
                              @bind="MoTa">
                    </textarea>
                </div>
            </div>
        </section>

        <!-- THÀNH PHẦN THANG THUỐC -->
        <section class="staff-form-card medicine-composition-card">
            <div class="medicine-section-head">
                <div>
                    <h2>Thành phần thang thuốc</h2>

                    <p>
                        Tick chọn nhiều dược liệu, sau đó thêm tất cả vào
                        thang thuốc chỉ bằng một lần bấm.
                    </p>
                </div>

                <div class="medicine-section-summary">
                    <span>
                        @ThanhPhanTam.Count thành phần
                    </span>

                    <strong>
                        @FormatMoney(GiaTinhTuDuocLieu)
                    </strong>
                </div>
            </div>

            <!-- CHỌN NHIỀU DƯỢC LIỆU -->
            <div class="medicine-multi-select">
                <div class="medicine-multi-toolbar">
                    <div class="mf-search medicine-herb-search">
                        <span>🔍</span>

                        <input placeholder="Tìm tên, mã hoặc đơn vị tính..."
                               @bind="DuocLieuSearchText"
                               @bind:event="oninput" />
                    </div>

                    <label class="medicine-select-all">
                        <input type="checkbox"
                               checked="@AreAllVisibleHerbsSelected"
                               @onchange="ToggleAllVisibleHerbs" />

                        <span>
                            Chọn tất cả đang hiển thị
                        </span>
                    </label>

                    <div class="medicine-selected-count">
                        Đã chọn:
                        <strong>@SelectedDuocLieuOids.Count</strong>
                    </div>
                </div>

                <div class="medicine-herb-checklist">
                    @foreach (DuocLieu duocLieu in DuocLieuDanhSachTick)
                    {
                        bool isSelected =
                            IsHerbSelected(duocLieu.Oid);

                        <label class="medicine-herb-check-row @(isSelected ? "selected" : string.Empty)">
                            <div class="medicine-herb-check-main">
                                <input type="checkbox"
                                       checked="@isSelected"
                                       @onchange="@(e => ToggleHerbSelection(
                                                                                  duocLieu.Oid,
                                                                                  e))" />

                                <div class="medicine-herb-avatar">
                                    🌿
                                </div>

                                <div class="medicine-herb-info">
                                    <strong>
                                        @EmptyText(duocLieu.TenDuocLieu)
                                    </strong>

                                    <small>
                                        @GetHerbCode(duocLieu)
                                    </small>
                                </div>
                            </div>

                            <div class="medicine-herb-unit">
                                @GetDvtName(duocLieu)
                            </div>

                            <div class="medicine-herb-price">
                                <small>Giá nhập</small>

                                <strong>
                                    @FormatMoney(
                                        duocLieu.GiaNhapGanNhat
                                    )
                                </strong>
                            </div>

                            <div class="@GetChecklistStockClass(duocLieu)">
                                <small>Tồn kho</small>

                                <strong>
                                    @FormatQuantity(
                                        duocLieu.SoLuongTon
                                    )
                                    @GetDvtName(duocLieu)
                                </strong>
                            </div>
                        </label>
                    }

                    @if (!DuocLieuDanhSachTick.Any())
                    {
                        <div class="medicine-herb-no-result">
                            Không còn dược liệu phù hợp để chọn.
                        </div>
                    }
                </div>

                <div class="medicine-multi-footer">
                    <div class="staff-form-group">
                        <label>
                            Số lượng mặc định cho mỗi thành phần
                        </label>

                        <input class="staff-form-control"
                               type="number"
                               min="0.01"
                               step="0.01"
                               @bind="SoLuongMacDinhChoDuocLieu" />

                        <small class="medicine-field-note">
                            Sau khi thêm, bạn vẫn có thể chỉnh riêng
                            từng dược liệu.
                        </small>
                    </div>

                    <div class="staff-form-group">
                        <label>Ghi chú mặc định</label>

                        <input class="staff-form-control"
                               placeholder="Không bắt buộc"
                               @bind="GhiChuMacDinhChoDuocLieu" />
                    </div>

                    <div class="medicine-add-selected">
                        <button class="mf-btn mf-btn-primary"
                                type="button"
                                disabled="@(SelectedDuocLieuOids.Count == 0)"
                                @onclick="AddSelectedIngredients">

                            + Thêm @SelectedDuocLieuOids.Count
                            dược liệu đã chọn
                        </button>
                    </div>
                </div>
            </div>

            <!-- BẢNG THÀNH PHẦN ĐÃ THÊM -->
            @if (ThanhPhanTam.Any())
            {
                <div class="medicine-table-wrapper">
                    <table class="mf-table medicine-ingredient-table">
                        <thead>
                            <tr>
                                <th>Dược liệu</th>
                                <th>Tồn hiện tại</th>
                                <th>Số lượng / 1 thuốc</th>
                                <th>Cần dùng lần này</th>
                                <th>Giá nhập</th>
                                <th>Thành tiền</th>
                                <th>Ghi chú</th>
                                <th>Thao tác</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (
                                MedicineIngredientRow item
                                in ThanhPhanTam
                            )
                            {
                                <tr>
                                    <td>
                                        <div class="staff-cell-main">
                                            <div class="staff-circle">
                                                D
                                            </div>

                                            <div>
                                                <strong>
                                                    @item.TenDuocLieu
                                                </strong>

                                                <small>
                                                    @item.MaDuocLieu
                                                </small>
                                            </div>
                                        </div>
                                    </td>

                                    <td>
                                        <strong>
                                            @FormatQuantity(item.TonKho)
                                        </strong>

                                        <small class="medicine-unit">
                                            @item.DonViTinh
                                        </small>
                                    </td>

                                    <td>
                                        <div class="medicine-quantity-input">
                                            <input type="number"
                                                   min="0.01"
                                                   step="0.01"
                                                   value="@ToInvariant(item.SoLuong)"
                                                   @oninput="@(e =>
                                                                                                          ChangeIngredientQuantity(
                                                                                                              item,
                                                                                                              e))" />

                                            <span>
                                                @item.DonViTinh
                                            </span>
                                        </div>
                                    </td>

                                    <td>
                                        <strong class="@GetRequiredStockClass(item)">
                                            @FormatQuantity(
                                                GetRequiredQuantity(item)
                                            )
                                        </strong>

                                        <small class="medicine-unit">
                                            @item.DonViTinh
                                        </small>
                                    </td>

                                    <td>
                                        @FormatMoney(item.GiaNhap)
                                    </td>

                                    <td>
                                        <strong>
                                            @FormatMoney(item.ThanhTien)
                                        </strong>
                                    </td>

                                    <td>
                                        <input class="medicine-note-input"
                                               value="@item.GhiChu"
                                               placeholder="Ghi chú..."
                                               @oninput="@(e =>
                                                                                                  ChangeIngredientNote(
                                                                                                      item,
                                                                                                      e))" />
                                    </td>

                                    <td>
                                        <button class="staff-table-btn danger"
                                                type="button"
                                                @onclick="@(() =>
                                                                                                    RemoveIngredient(item))">
                                            Xóa
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>

                        <tfoot>
                            <tr>
                                <td colspan="5">
                                    <strong>
                                        Giá dược liệu cho một đơn vị thuốc
                                    </strong>
                                </td>

                                <td>
                                    <strong>
                                        @FormatMoney(GiaTinhTuDuocLieu)
                                    </strong>
                                </td>

                                <td colspan="2"></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }
            else
            {
                <div class="medicine-empty-ingredients">
                    <div>🌿</div>

                    <strong>
                        Chưa có thành phần dược liệu
                    </strong>

                    <p>
                        Tick chọn các dược liệu phía trên rồi bấm
                        “Thêm dược liệu đã chọn”.
                    </p>
                </div>
            }

            
        </section>

        
    </main>
</div>

<style>
    .medicine-composition-card {
        margin-top: 24px;
    }

    .medicine-section-head {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 24px;
        padding-bottom: 20px;
        border-bottom: 1px solid #dbe5f1;
    }

    .medicine-section-head h2 {
        margin: 0 0 6px;
        color: #0f172a;
        font-size: 22px;
        font-weight: 800;
    }

    .medicine-section-head p {
        margin: 0;
        color: #64748b;
    }

    .medicine-section-summary {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 4px;
        white-space: nowrap;
    }

    .medicine-section-summary span {
        color: #64748b;
        font-size: 14px;
    }

    .medicine-section-summary strong {
        color: #0f766e;
        font-size: 21px;
    }

    .medicine-checkbox {
        display: flex;
        align-items: center;
        gap: 10px;
        min-height: 44px;
        padding: 10px 13px;
        border: 1px solid #d7e2ef;
        border-radius: 10px;
        background: #ffffff;
        cursor: pointer;
    }

    .medicine-checkbox input {
        width: 18px;
        height: 18px;
        accent-color: #0f8a80;
    }

    .medicine-field-note {
        display: block;
        margin-top: 6px;
        color: #64748b;
        font-size: 12px;
        line-height: 1.4;
    }

    .medicine-multi-select {
        margin-top: 22px;
        overflow: hidden;
        border: 1px solid #dbe5f1;
        border-radius: 14px;
        background: #ffffff;
    }

    .medicine-multi-toolbar {
        display: grid;
        grid-template-columns:
            minmax(280px, 1fr)
            auto
            auto;
        align-items: center;
        gap: 18px;
        padding: 16px 18px;
        border-bottom: 1px solid #dbe5f1;
        background: #f8fafc;
    }

    .medicine-herb-search {
        width: 100%;
    }

    .medicine-select-all {
        display: flex;
        align-items: center;
        gap: 9px;
        color: #334155;
        font-weight: 700;
        cursor: pointer;
        white-space: nowrap;
    }

    .medicine-select-all input,
    .medicine-herb-check-main input {
        width: 18px;
        height: 18px;
        margin: 0;
        accent-color: #0f8a80;
        cursor: pointer;
    }

    .medicine-selected-count {
        padding: 8px 13px;
        border-radius: 999px;
        background: #ccfbf1;
        color: #0f766e;
        white-space: nowrap;
    }

    .medicine-herb-checklist {
        max-height: 390px;
        overflow-y: auto;
        padding: 8px;
    }

    .medicine-herb-check-row {
        display: grid;
        grid-template-columns:
            minmax(280px, 1.5fr)
            minmax(100px, 0.5fr)
            minmax(140px, 0.7fr)
            minmax(150px, 0.7fr);
        align-items: center;
        gap: 18px;
        margin-bottom: 6px;
        padding: 13px 14px;
        border: 1px solid transparent;
        border-radius: 11px;
        cursor: pointer;
        transition:
            background 0.15s ease,
            border-color 0.15s ease;
    }

    .medicine-herb-check-row:hover {
        background: #f1f5f9;
    }

    .medicine-herb-check-row.selected {
        border-color: #5eead4;
        background: #ecfdf5;
    }

    .medicine-herb-check-main {
        display: flex;
        align-items: center;
        gap: 12px;
        min-width: 0;
    }

    .medicine-herb-avatar {
        display: flex;
        width: 38px;
        height: 38px;
        flex: 0 0 38px;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #ccfbf1;
    }

    .medicine-herb-info {
        display: flex;
        min-width: 0;
        flex-direction: column;
        gap: 3px;
    }

    .medicine-herb-info strong {
        overflow: hidden;
        color: #0f172a;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .medicine-herb-info small,
    .medicine-herb-price small,
    .medicine-herb-stock small {
        color: #64748b;
    }

    .medicine-herb-unit {
        color: #334155;
        font-weight: 600;
    }

    .medicine-herb-price,
    .medicine-herb-stock {
        display: flex;
        flex-direction: column;
        gap: 3px;
    }

    .medicine-herb-price strong {
        color: #0f172a;
    }

    .medicine-herb-stock.success strong {
        color: #15803d;
    }

    .medicine-herb-stock.warning strong {
        color: #d97706;
    }

    .medicine-herb-stock.danger strong {
        color: #dc2626;
    }

    .medicine-herb-no-result {
        padding: 36px 20px;
        color: #64748b;
        text-align: center;
    }

    .medicine-multi-footer {
        display: grid;
        grid-template-columns:
            minmax(220px, 1fr)
            minmax(240px, 1.5fr)
            auto;
        align-items: end;
        gap: 18px;
        padding: 18px;
        border-top: 1px solid #dbe5f1;
        background: #f8fafc;
    }

    .medicine-add-selected {
        padding-bottom: 1px;
    }

    .medicine-add-selected .mf-btn {
        min-height: 44px;
        white-space: nowrap;
    }

    .medicine-add-selected .mf-btn:disabled {
        cursor: not-allowed;
        opacity: 0.55;
    }

    .medicine-table-wrapper {
        width: 100%;
        margin-top: 22px;
        overflow-x: auto;
        border: 1px solid #dbe5f1;
        border-radius: 14px;
    }

    .medicine-ingredient-table {
        min-width: 1120px;
        margin: 0;
    }

    .medicine-ingredient-table tfoot td {
        background: #f8fafc;
        border-top: 2px solid #dbe5f1;
    }

    .medicine-quantity-input {
        display: flex;
        align-items: center;
        min-width: 145px;
        overflow: hidden;
        border: 1px solid #cbd5e1;
        border-radius: 9px;
        background: #ffffff;
    }

    .medicine-quantity-input:focus-within {
        border-color: #0f8a80;
        box-shadow:
            0 0 0 3px rgba(15, 138, 128, 0.12);
    }

    .medicine-quantity-input input {
        width: 92px;
        min-width: 0;
        padding: 9px 10px;
        border: 0;
        outline: none;
        background: transparent;
        color: #0f172a;
    }

    .medicine-quantity-input span {
        flex: 1;
        padding: 9px 10px;
        border-left: 1px solid #e2e8f0;
        background: #f8fafc;
        color: #64748b;
        text-align: center;
    }

    .medicine-note-input {
        width: 180px;
        padding: 9px 10px;
        border: 1px solid #cbd5e1;
        border-radius: 9px;
        outline: none;
    }

    .medicine-note-input:focus {
        border-color: #0f8a80;
        box-shadow:
            0 0 0 3px rgba(15, 138, 128, 0.12);
    }

    .medicine-unit {
        display: inline-block;
        margin-left: 4px;
        color: #64748b;
    }

    .medicine-stock-sufficient {
        color: #15803d;
    }

    .medicine-stock-insufficient {
        color: #dc2626;
    }

    .medicine-empty-ingredients {
        margin-top: 22px;
        padding: 40px 24px;
        border: 1px dashed #b8c7d9;
        border-radius: 14px;
        background: #f8fafc;
        text-align: center;
    }

    .medicine-empty-ingredients > div {
        margin-bottom: 8px;
        font-size: 34px;
    }

    .medicine-empty-ingredients strong {
        display: block;
        margin-bottom: 6px;
        color: #0f172a;
        font-size: 17px;
    }

    .medicine-empty-ingredients p {
        margin: 0;
        color: #64748b;
    }

    .medicine-stock-note {
        display: flex;
        gap: 8px;
        margin-top: 18px;
        padding: 14px 16px;
        border: 1px solid #bfdbfe;
        border-radius: 12px;
        background: #eff6ff;
        color: #1e3a8a;
    }

    .medicine-save-summary {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 24px;
        margin-top: 24px;
    }

    .medicine-save-summary h3 {
        margin: 0 0 5px;
        color: #0f172a;
    }

    .medicine-save-summary p {
        margin: 0;
        color: #64748b;
    }

    .staff-table-btn.danger {
        background: #fee2e2;
        color: #b91c1c;
    }

    .staff-table-btn.danger:hover {
        background: #fecaca;
        color: #991b1b;
    }

