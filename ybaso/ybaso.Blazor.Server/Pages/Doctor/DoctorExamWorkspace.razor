    private string TuoiText
    {
        get
        {
            Benhnhan benhNhan = BenhNhanHienThi;

            if (benhNhan != null)
            {
                int tuoi = TinhTuoi(
                    benhNhan.Ngaysinh
                );

                return tuoi <= 0
                    ? "Chưa xác định"
                    : tuoi.ToString();
            }

            if (CaKham == null || CaKham.Tuoi <= 0)
            {
                return "Chưa xác định";
            }

            return CaKham.Tuoi.ToString();
        }
    }

