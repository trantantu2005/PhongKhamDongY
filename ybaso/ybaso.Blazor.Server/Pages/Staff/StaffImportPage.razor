@page "/staff/imports"

@using System.Linq
@using DevExpress.ExpressApp
@using Microsoft.AspNetCore.Components.Authorization
@using ybaso.Module.BusinessObjects
@implements IDisposable

@inject IObjectSpaceFactory ObjectSpaceFactory
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider

<div class="staff-page">
    <StaffSidebar ActiveMenu="imports" />

    <main class="staff-main">
        <header class="mf-topbar">
            <div>
                <h1>Phiếu nhập kho dược liệu</h1>

                <p>
                    Nhập dược liệu từ nhà cung cấp, cập nhật số lượng tồn
                    và giá nhập gần nhất.
                </p>
            </div>

            <div class="mf-actions">
                <button class="mf-btn mf-btn-outline"
                        type="button"
                        @onclick="ReloadData">
                    Làm mới
                </button>

                <button class="mf-btn mf-btn-primary"
                        type="button"
                        @onclick="GoHerbs">
                    Danh mục dược liệu
                </button>
            </div>
        </header>

        @if (!string.IsNullOrWhiteSpace(Message))
        {
            <div class="@MessageClass">
                @Message
            </div>
        }

        <!-- THỐNG KÊ -->
        <section class="staff-stats">
            <div class="staff-stat-card">
                <div class="staff-stat-icon teal">
                    🌿
                </div>

                <div>
                    <p>Tổng dược liệu</p>
                    <h3>@TongDuocLieu</h3>
                </div>
            </div>

            <div class="staff-stat-card">
                <div class="staff-stat-icon orange">
                    ⚠️
                </div>

                <div>
                    <p>Cần nhập thêm</p>
                    <h3>@DuocLieuCanNhap</h3>
                </div>
            </div>

            <div class="staff-stat-card">
                <div class="staff-stat-icon green">
                    📦
                </div>

                <div>
                    <p>Còn hàng</p>
                    <h3>@DuocLieuConHang</h3>
                </div>
            </div>

            <div class="staff-stat-card">
                <div class="staff-stat-icon blue">
                    💰
                </div>

                <div>
                    <p>Giá trị phiếu nhập</p>
                    <h3>@FormatMoney(ThanhTienNhap)</h3>
                </div>
            </div>
        </section>

        <section class="staff-import-layout">
            <!-- FORM NHẬP KHO -->
            <div class="staff-import-main">
                <section class="staff-form-card">
                    <div class="staff-form-header">
                        <div class="staff-form-avatar">
                            📥
                        </div>

                        <div>
                            <h2>Tạo phiếu nhập dược liệu</h2>

                            <p>
                                Chọn một dược liệu trong danh mục và nhập
                                số lượng nhận từ nhà cung cấp.
                            </p>
                        </div>
                    </div>

                    <div class="staff-form-grid">
                        <div class="staff-form-group full">
                            <label>
                                Dược liệu
                                <span class="required">*</span>
                            </label>

                            <select class="staff-form-control"
                                    value="@SelectedDuocLieuOid"
                                    @onchange="OnDuocLieuChanged">

                                <option value="0">
                                    -- Chọn dược liệu cần nhập --
                                </option>

                                @foreach (DuocLieu item in DanhSachDuocLieu)
                                {
                                    <option value="@item.Oid">
                                        @item.TenDuocLieu
                                        - Tồn:
                                        @FormatQuantity(item.SoLuongTon)
                                        @GetDonViTinh(item)
                                    </option>
                                }
                            </select>

                            <small class="staff-field-note">
                                Danh sách này chỉ hiển thị dược liệu,
                                không hiển thị thang thuốc.
                            </small>
                        </div>

                        <div class="staff-form-group">
                            <label>
                                Nhân viên nhập kho
                                <span class="required">*</span>
                            </label>

                            <select class="staff-form-control"
                                    value="@SelectedNhanVienOid"
                                    @onchange="OnNhanVienChanged">

                                <option value="0">
                                    -- Chọn nhân viên --
                                </option>

                                @foreach (Nhanvien nhanVien in DanhSachNhanVien)
                                {
                                    <option value="@nhanVien.Oid">
                                        @GetNhanVienName(nhanVien)
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="staff-form-group">
                            <label>Ngày nhập</label>

                            <input class="staff-form-control"
                                   type="datetime-local"
                                   value="@NgayNhapValue"
                                   @onchange="OnNgayNhapChanged" />
                        </div>

                        <div class="staff-form-group">
                            <label>Nhà cung cấp</label>

                            <input class="staff-form-control"
                                   placeholder="Nhập tên nhà cung cấp..."
                                   @bind="NhaCungCap" />
                        </div>

                        <div class="staff-form-group">
                            <label>
                                Số lượng nhập
                                <span class="required">*</span>
                            </label>

                            <input class="staff-form-control"
                                   type="number"
                                   min="0.01"
                                   step="0.01"
                                   @bind="SoLuongNhap" />
                        </div>

                        <div class="staff-form-group">
                            <label>
                                Đơn giá nhập
                                <span class="required">*</span>
                            </label>

                            <input class="staff-form-control"
                                   type="number"
                                   min="0"
                                   step="1000"
                                   @bind="DonGiaNhap" />
                        </div>

                        <div class="staff-form-group">
                            <label>Thành tiền</label>

                            <input class="staff-form-control"
                                   value="@FormatMoney(ThanhTienNhap)"
                                   disabled />
                        </div>

                        <div class="staff-form-group">
                            <label>Số lô</label>

                            <input class="staff-form-control"
                                   placeholder="VD: LO-2026-001"
                                   @bind="SoLo" />
                        </div>

                        <div class="staff-form-group">
                            <label>Hạn sử dụng</label>

                            <input class="staff-form-control"
                                   type="date"
                                   value="@HanSuDungValue"
                                   @onchange="OnHanSuDungChanged" />
                        </div>

                        <div class="staff-form-group full">
                            <label>Ghi chú</label>

                            <textarea class="staff-form-control"
                                      placeholder="Nhập ghi chú cho phiếu nhập..."
                                      @bind="GhiChu">
                            </textarea>
                        </div>
                    </div>

                    <div class="staff-form-footer">
                        <button class="mf-btn mf-btn-outline"
                                type="button"
                                disabled="@IsSaving"
                                @onclick="ResetForm">
                            Nhập lại
                        </button>

                        <button class="mf-btn mf-btn-primary"
                                type="button"
                                disabled="@IsSaving"
                                @onclick="ImportHerb">

                            @(IsSaving
                                ? "Đang nhập kho..."
                                : "📥 Xác nhận nhập kho")
                        </button>
                    </div>
                </section>
            </div>

            <!-- THÔNG TIN BÊN PHẢI -->
            <aside class="staff-import-side">
                <section class="staff-form-card">
                    <div class="staff-section-head-simple">
                        <h2>Thông tin dược liệu</h2>

                        <p>
                            Thông tin của dược liệu đang được chọn.
                        </p>
                    </div>

                    @if (SelectedDuocLieu == null)
                    {
                        <div class="mf-empty">
                            Chưa chọn dược liệu.
                        </div>
                    }
                    else
                    {
                        <div class="staff-info-list">
                            <div>
                                <span>Mã dược liệu</span>

                                <strong>
                                    @GetMaDuocLieu(SelectedDuocLieu)
                                </strong>
                            </div>

                            <div>
                                <span>Tên dược liệu</span>

                                <strong>
                                    @SelectedDuocLieu.TenDuocLieu
                                </strong>
                            </div>

                            <div>
                                <span>Đơn vị tính</span>

                                <strong>
                                    @GetDonViTinh(SelectedDuocLieu)
                                </strong>
                            </div>

                            <div>
                                <span>Tồn hiện tại</span>

                                <strong>
                                    @FormatQuantity(
                                        SelectedDuocLieu.SoLuongTon
                                    )
                                    @GetDonViTinh(SelectedDuocLieu)
                                </strong>
                            </div>

                            <div>
                                <span>Số lượng nhập</span>

                                <strong>
                                    @FormatQuantity(SoLuongNhap)
                                    @GetDonViTinh(SelectedDuocLieu)
                                </strong>
                            </div>

                            <div>
                                <span>Sau khi nhập</span>

                                <strong class="staff-import-new-stock">
                                    @FormatQuantity(TonSauKhiNhap)
                                    @GetDonViTinh(SelectedDuocLieu)
                                </strong>
                            </div>

                            <div>
                                <span>Giá nhập gần nhất</span>

                                <strong>
                                    @FormatMoney(
                                        SelectedDuocLieu.GiaNhapGanNhat
                                    )
                                </strong>
                            </div>

                            <div>
                                <span>Giá nhập mới</span>

                                <strong>
                                    @FormatMoney(DonGiaNhap)
                                </strong>
                            </div>

                            <div>
                                <span>Trạng thái kho</span>

                                <span class="@GetStockStatusClass(
                                                                          SelectedDuocLieu)">
                                    @GetStockStatusText(
                                        SelectedDuocLieu)
                                </span>
                            </div>
                        </div>
                    }
                </section>

                <section class="staff-form-card mt-16">
                    <div class="staff-section-head-simple">
                        <h2>Dược liệu cần nhập</h2>

                        <p>
                            Các dược liệu có tồn kho thấp hoặc đã hết hàng.
                        </p>
                    </div>

                    <div class="staff-small-list">
                        @foreach (
                            DuocLieu item
                            in DanhSachDuocLieuCanNhap.Take(8))
                        {
                            <div class="staff-small-item">
                                <div>
                                    <strong>
                                        @item.TenDuocLieu
                                    </strong>

                                    <span>
                                        Tồn:
                                        @FormatQuantity(item.SoLuongTon)
                                        @GetDonViTinh(item)
                                    </span>
                                </div>

                                <button class="staff-table-btn light"
                                        type="button"
                                        @onclick="() => SelectHerb(item.Oid)">
                                    Chọn
                                </button>
                            </div>
                        }
                    </div>

                    @if (!DanhSachDuocLieuCanNhap.Any())
                    {
                        <div class="mf-empty">
                            Không có dược liệu cần nhập thêm.
                        </div>
                    }
                </section>
            </aside>
        </section>
    </main>
</div>

<style>
    .staff-field-note {
        display: block;
        margin-top: 7px;
        color: #64748b;
        font-size: 12px;
        line-height: 1.45;
    }

    .staff-import-new-stock {
        color: #15803d !important;
    }

    .staff-form-control:disabled {
        background: #f1f5f9;
        color: #334155;
        cursor: not-allowed;
        opacity: 1;
    }
</style>

@code {
    private IObjectSpace objectSpace;

    private string CurrentUserName = "Nhân viên";

    private string Message = string.Empty;

    private string MessageClass =
        "mf-alert mf-alert-success";

    private List<DuocLieu> DanhSachDuocLieu = new();

    private List<Nhanvien> DanhSachNhanVien = new();

    private int SelectedDuocLieuOid;

    private int SelectedNhanVienOid;

    private DateTime NgayNhap = DateTime.Now;

    private decimal SoLuongNhap = 1;

    private decimal DonGiaNhap;

    private string NhaCungCap = string.Empty;

    private string SoLo = string.Empty;

    private DateTime? HanSuDung;

    private string GhiChu = string.Empty;

    private bool IsSaving;

    private string NgayNhapValue =>
        NgayNhap.ToString("yyyy-MM-ddTHH:mm");

    private string HanSuDungValue =>
        HanSuDung.HasValue
            ? HanSuDung.Value.ToString("yyyy-MM-dd")
            : string.Empty;

    private decimal ThanhTienNhap =>
        SoLuongNhap * DonGiaNhap;

    private DuocLieu SelectedDuocLieu =>
        DanhSachDuocLieu.FirstOrDefault(
            x => x.Oid == SelectedDuocLieuOid
        );

    private decimal TonSauKhiNhap =>
        SelectedDuocLieu == null
            ? 0
            : SelectedDuocLieu.SoLuongTon +
              SoLuongNhap;

    private int TongDuocLieu =>
        DanhSachDuocLieu.Count;

    private int DuocLieuCanNhap =>
        DanhSachDuocLieu.Count(IsLowStock);

    private int DuocLieuConHang =>
        DanhSachDuocLieu.Count(
            x => x.SuDung && x.SoLuongTon > 0
        );

    private List<DuocLieu> DanhSachDuocLieuCanNhap =>
        DanhSachDuocLieu
            .Where(IsLowStock)
            .OrderBy(x => x.SoLuongTon)
            .ThenBy(x => x.TenDuocLieu)
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        objectSpace =
            ObjectSpaceFactory.CreateObjectSpace(
                typeof(PhieuNhapKho)
            );

        var authenticationState =
            await AuthenticationStateProvider
                .GetAuthenticationStateAsync();

        CurrentUserName =
            authenticationState.User?.Identity?.Name
            ?? "Nhân viên";

        LoadData();
        SelectCurrentEmployee();
    }

    private void LoadData()
    {
        DanhSachDuocLieu =
            objectSpace
                .GetObjects<DuocLieu>()
                .Where(x => x.SuDung)
                .OrderBy(x => x.TenDuocLieu)
                .ToList();

        DanhSachNhanVien =
            objectSpace
                .GetObjects<Nhanvien>()
                .OrderBy(x => x.Hodem)
                .ThenBy(x => x.Ten)
                .ToList();
    }

    private void SelectCurrentEmployee()
    {
        if (SelectedNhanVienOid > 0)
            return;

        Nhanvien nhanVienDangNhap =
            DanhSachNhanVien.FirstOrDefault(x =>
                x.TaiKhoanDangNhap != null &&
                string.Equals(
                    x.TaiKhoanDangNhap.UserName,
                    CurrentUserName,
                    StringComparison.OrdinalIgnoreCase
                )
            );

        if (nhanVienDangNhap != null)
        {
            SelectedNhanVienOid =
                nhanVienDangNhap.Oid;

            return;
        }

        if (DanhSachNhanVien.Count == 1)
        {
            SelectedNhanVienOid =
                DanhSachNhanVien[0].Oid;
        }
    }

    private void ReloadData()
    {
        try
        {
            objectSpace.Refresh();
            LoadData();
            SelectCurrentEmployee();

            MessageClass =
                "mf-alert mf-alert-success";

            Message =
                "Đã làm mới dữ liệu nhập kho dược liệu.";
        }
        catch (Exception ex)
        {
            ShowError(
                "Không thể làm mới dữ liệu: " +
                GetErrorMessage(ex)
            );
        }
    }

    private void OnDuocLieuChanged(
        ChangeEventArgs e)
    {
        int.TryParse(
            e.Value?.ToString(),
            out SelectedDuocLieuOid
        );

        DuocLieu selected =
            SelectedDuocLieu;

        if (selected != null)
        {
            DonGiaNhap =
                selected.GiaNhapGanNhat;
        }
        else
        {
            DonGiaNhap = 0;
        }
    }

    private void OnNhanVienChanged(
        ChangeEventArgs e)
    {
        int.TryParse(
            e.Value?.ToString(),
            out SelectedNhanVienOid
        );
    }

    private void OnNgayNhapChanged(
        ChangeEventArgs e)
    {
        string value =
            e.Value?.ToString()
            ?? string.Empty;

        if (DateTime.TryParse(
            value,
            out DateTime result))
        {
            NgayNhap = result;
        }
    }

    private void OnHanSuDungChanged(
        ChangeEventArgs e)
    {
        string value =
            e.Value?.ToString()
            ?? string.Empty;

        if (string.IsNullOrWhiteSpace(value))
        {
            HanSuDung = null;
            return;
        }

        if (DateTime.TryParse(
            value,
            out DateTime result))
        {
            HanSuDung = result.Date;
        }
    }

    private void SelectHerb(int oid)
    {
        SelectedDuocLieuOid = oid;

        DuocLieu selected =
            SelectedDuocLieu;

        DonGiaNhap =
            selected?.GiaNhapGanNhat ?? 0;

        Message = string.Empty;
    }

    private void ResetForm()
    {
        SelectedDuocLieuOid = 0;
        NgayNhap = DateTime.Now;
        SoLuongNhap = 1;
        DonGiaNhap = 0;
        NhaCungCap = string.Empty;
        SoLo = string.Empty;
        HanSuDung = null;
        GhiChu = string.Empty;
        Message = string.Empty;
    }

    private bool ValidateImport()
    {
        Message = string.Empty;

        if (SelectedDuocLieuOid <= 0 ||
            SelectedDuocLieu == null)
        {
            ShowError(
                "Vui lòng chọn dược liệu cần nhập."
            );

            return false;
        }

        if (SelectedNhanVienOid <= 0)
        {
            ShowError(
                "Vui lòng chọn nhân viên thực hiện nhập kho."
            );

            return false;
        }

        if (SoLuongNhap <= 0)
        {
            ShowError(
                "Số lượng nhập phải lớn hơn 0."
            );

            return false;
        }

        if (DonGiaNhap < 0)
        {
            ShowError(
                "Đơn giá nhập không được nhỏ hơn 0."
            );

            return false;
        }

        if (HanSuDung.HasValue &&
            HanSuDung.Value.Date < NgayNhap.Date)
        {
            ShowError(
                "Hạn sử dụng không được nhỏ hơn ngày nhập."
            );

            return false;
        }

        return true;
    }

    private void ImportHerb()
    {
        if (IsSaving)
            return;

        IsSaving = true;

        try
        {
            if (!ValidateImport())
                return;

            DuocLieu duocLieu =
                objectSpace.GetObjectByKey<DuocLieu>(
                    SelectedDuocLieuOid
                );

            Nhanvien nhanVien =
                objectSpace.GetObjectByKey<Nhanvien>(
                    SelectedNhanVienOid
                );

            if (duocLieu == null)
            {
                ShowError(
                    "Không tìm thấy dược liệu cần nhập."
                );

                return;
            }

            if (nhanVien == null)
            {
                ShowError(
                    "Không tìm thấy nhân viên nhập kho."
                );

                return;
            }

            PhieuNhapKho phieuNhap =
                objectSpace.CreateObject<PhieuNhapKho>();

            phieuNhap.NhanVien =
                nhanVien;

            phieuNhap.NgayNhap =
                NgayNhap;

            phieuNhap.NhaCungCap =
                string.IsNullOrWhiteSpace(NhaCungCap)
                    ? null
                    : NhaCungCap.Trim();

            phieuNhap.GhiChu =
                string.IsNullOrWhiteSpace(GhiChu)
                    ? null
                    : GhiChu.Trim();

            ChiTietPhieuNhap chiTiet =
                objectSpace
                    .CreateObject<ChiTietPhieuNhap>();

            chiTiet.PhieuNhap =
                phieuNhap;

            chiTiet.DuocLieu =
                duocLieu;

            chiTiet.SoLuong =
                SoLuongNhap;

            chiTiet.GiaNhap =
                DonGiaNhap;

            chiTiet.SoLo =
                string.IsNullOrWhiteSpace(SoLo)
                    ? null
                    : SoLo.Trim();

            chiTiet.HanSuDung =
                HanSuDung;

            chiTiet.GhiChu =
                string.IsNullOrWhiteSpace(GhiChu)
                    ? null
                    : GhiChu.Trim();

            chiTiet.CapNhatThanhTien();
            phieuNhap.CapNhatTongTien();

            /*
             * XacNhanNhapKho sẽ:
             * - Chuyển trạng thái sang Đã nhập.
             * - Tăng số lượng tồn của dược liệu.
             * - Cập nhật giá nhập gần nhất.
             * - Đánh dấu phiếu đã cập nhật tồn.
             */
            phieuNhap.XacNhanNhapKho();

            objectSpace.CommitChanges();

            string maPhieu =
                phieuNhap.MaPhieuNhap;

            string tenDuocLieu =
                duocLieu.TenDuocLieu;

            string donViTinh =
                GetDonViTinh(duocLieu);

            decimal soLuongVuaNhap =
                SoLuongNhap;

            objectSpace.Refresh();
            LoadData();

            ResetForm();
            SelectCurrentEmployee();

            MessageClass =
                "mf-alert mf-alert-success";

            Message =
                $"Đã tạo phiếu {maPhieu} và nhập " +
                $"{FormatQuantity(soLuongVuaNhap)} " +
                $"{donViTinh} {tenDuocLieu} vào kho.";
        }
        catch (Exception ex)
        {
            ShowError(
                "Không thể nhập kho dược liệu: " +
                GetErrorMessage(ex)
            );
        }
        finally
        {
            IsSaving = false;
        }
    }

    private bool IsLowStock(
        DuocLieu item)
    {
        if (item == null || !item.SuDung)
            return false;

        return item.SoLuongTon <=
               item.TonToiThieu;
    }

    private string GetStockStatusText(
        DuocLieu item)
    {
        if (item == null ||
            item.SoLuongTon <= 0)
        {
            return "Hết hàng";
        }

        if (item.SoLuongTon <=
            item.TonToiThieu)
        {
            return "Sắp hết";
        }

        return "Còn hàng";
    }

    private string GetStockStatusClass(
        DuocLieu item)
    {
        if (item == null ||
            item.SoLuongTon <= 0)
        {
            return "staff-status danger";
        }

        if (item.SoLuongTon <=
            item.TonToiThieu)
        {
            return "staff-status warning";
        }

        return "staff-status success";
    }

    private string GetMaDuocLieu(
        DuocLieu item)
    {
        if (item == null)
            return "--";

        if (!string.IsNullOrWhiteSpace(
            item.MaDuocLieu))
        {
            return item.MaDuocLieu;
        }

        return $"DL-{item.Oid:0000}";
    }

    private string GetDonViTinh(
        DuocLieu item)
    {
        return item?.DonViTinh?.TenDvt
               ?? "--";
    }

    private string GetNhanVienName(
        Nhanvien item)
    {
        if (item == null)
            return "--";

        if (!string.IsNullOrWhiteSpace(
            item.HoTen))
        {
            return item.HoTen;
        }

        return $"Nhân viên #{item.Oid}";
    }

    private void ShowError(
        string message)
    {
        MessageClass =
            "mf-alert mf-alert-danger";

        Message = message;
    }

    private string GetErrorMessage(
        Exception ex)
    {
        Exception current = ex;

        while (
            current.InnerException != null &&
            !string.IsNullOrWhiteSpace(
                current.InnerException.Message))
        {
            current =
                current.InnerException;
        }

        return current.Message;
    }

    private string FormatMoney(
        decimal value)
    {
        return value.ToString("n0") +
               " đ";
    }

    private string FormatQuantity(
        decimal value)
    {
        return value.ToString("0.##");
    }

    private void GoHerbs()
    {
        Navigation.NavigateTo(
            "/staff/herbs"
        );
    }

    public void Dispose()
    {
        objectSpace?.Dispose();
    }
}