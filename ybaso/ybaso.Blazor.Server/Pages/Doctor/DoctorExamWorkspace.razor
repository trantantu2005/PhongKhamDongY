    private void UpdateSoDo(
        CakhamSoDoChiTiet dong,
        bool laBenTrai,
        object rawValue)
    {
        if (dong == null)
        {
            return;
        }

        double value =
            ParseDouble(rawValue?.ToString());

        if (laBenTrai)
        {
            dong.Trai = value;
        }
        else
        {
            dong.Phai = value;
        }

        CaKham?.DanhDauCanPhanTich();
        Message = "";
    }

    private void SaveSoDo()
    {
        if (CaKham == null)
