    private decimal Revenue =>
        PaidInvoices.Sum(x =>
            x.TongThanhToan
        );

    private decimal MedicineRevenue =>
        PaidInvoices.Sum(x =>
            x.TongTienThuoc
        );

    private decimal ExamRevenue =>
        PaidInvoices.Sum(x =>
            x.TienKham
        );

    private decimal Discount =>
        PaidInvoices.Sum(x =>
            x.GiamGia
        );

    private decimal ImportCost =>
        CompletedImports.Sum(x =>
            x.TongTien
        );

    private decimal ExportValue =>
        CompletedExports.Sum(x =>
            x.TongTien
        );

    private decimal EstimatedProfit =>
        Revenue - ImportCost;

    private decimal CashRevenue =>
        PaidInvoices
            .Where(x =>
                x.HinhThucThanhToan ==
                    HinhThucThanhToanHoaDon.TienMat
            )
            .Sum(x => x.TongThanhToan);

    private decimal TransferRevenue =>
        PaidInvoices
            .Where(x =>
                x.HinhThucThanhToan ==
                    HinhThucThanhToanHoaDon.ChuyenKhoan
            )
            .Sum(x => x.TongThanhToan);

    private decimal OtherRevenue =>
        PaidInvoices
            .Where(x =>
                x.HinhThucThanhToan ==
                    HinhThucThanhToanHoaDon.Khac
            )
            .Sum(x => x.TongThanhToan);

    private decimal TongGiaTriTonDuocLieu =>
        Herbs.Sum(x =>
            x.SoLuongTon *
            x.GiaNhapGanNhat
        );

    private decimal TongGiaTriTonThuoc =>
        Medicines.Sum(x =>
            x.SoLuongTon *
            x.GiaBan
        );

