    private void LoadData()
    {
        if (objectSpace == null)
        {
            return;
        }

        objectSpace.Refresh();

        CaKham =
            objectSpace.GetObjectByKey<Cakham>(Oid);

        DanhSachBenhNhan =
            objectSpace.GetObjects<Benhnhan>()
                .OrderBy(x => x.Ten)
                .ThenBy(x => x.Ho)
                .ToList();

        DanhSachBacSi =
            objectSpace.GetObjects<Nhanvien>()
                .OrderBy(x => x.Ten)
                .ToList();

        if (CaKham == null)
        {
            return;
        }

        SelectedBenhNhanOid =
            CaKham.BenhNhan?.Oid.ToString()
            ?? "";

        SelectedBacSiOid =
            CaKham.Bacsi?.Oid.ToString()
            ?? "";

        NgayKham =
            CaKham.NgayCT == DateTime.MinValue
                ? DateTime.Now
                : CaKham.NgayCT;

        LoaiLuotKhamValue =
            CaKham.LoaiLuotKham.ToString();

        LoaiCaKhamValue =
            CaKham.LoaiCakham.ToString();

        TrangThaiValue =
            CaKham.TrangThai.ToString();

        ChieuCao = CaKham.Chieucao;
        CanNang = CaKham.Cannang;

        NhietDoMoiTruong =
            CaKham.NhietDoMoiTruong;

        LyDoKham =
            CaKham.LydoKham ?? "";

        EnsureSoDoDefaults();
    }

