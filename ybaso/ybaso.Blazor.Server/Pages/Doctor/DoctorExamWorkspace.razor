        }

        try
        {
            CaKham.DanhDauCanPhanTich();

            objectSpace.CommitChanges();

            MessageClass =
                "mf-alert mf-alert-success";

            Message =
                "Đã lưu số đo thành công.";
        }
        catch (Exception ex)
        {
            MessageClass =
                "mf-alert mf-alert-danger";

            Message =
                "Lỗi khi lưu số đo: "
                + ex.Message;
        }
    }

