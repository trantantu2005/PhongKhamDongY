@page "/staff/reports"

@using System.Linq
@using DevExpress.ExpressApp
@using Microsoft.JSInterop
@using ybaso.Module.BusinessObjects
@implements IDisposable

@inject IObjectSpaceFactory ObjectSpaceFactory
@inject IJSRuntime JS

<div class="staff-page report-page">
    <div class="report-sidebar no-print">
        <StaffSidebar ActiveMenu="reports" />
    </div>

    <main class="staff-main">
        <header class="mf-topbar no-print">
            <div>
                <h1>Báo cáo nhân viên</h1>

                <p>
                    Thống kê hoạt động khám bệnh, kho dược
                    và doanh thu theo thời gian.
                </p>
            </div>

            <div class="mf-actions">
                <button class="mf-btn mf-btn-outline"
                        type="button"
                        @onclick="ReloadData">
                    Làm mới
                </button>

                <button class="mf-btn mf-btn-primary"
                        type="button"
                        @onclick="PrintReport">
                    🖨 In báo cáo
                </button>
            </div>
        </header>

        @if (!string.IsNullOrWhiteSpace(Message))
        {
            <div class="@MessageClass no-print">
                @Message
            </div>
        }

        <section class="mf-card report-filter no-print">
            <div class="report-filter-top">
                <div>
                    <h2>Bộ lọc báo cáo</h2>

                    <p>
                        Dữ liệu được tổng hợp trực tiếp
                        từ cơ sở dữ liệu.
                    </p>
                </div>

                <div class="report-button-row">
                    <button class="@RangeClass("today")"
                            type="button"
                            @onclick='() => SetRange("today")'>
                        Hôm nay
                    </button>

                    <button class="@RangeClass("7days")"
                            type="button"
                            @onclick='() => SetRange("7days")'>
                        7 ngày
                    </button>

                    <button class="@RangeClass("month")"
                            type="button"
                            @onclick='() => SetRange("month")'>
                        Tháng này
                    </button>

                    <button class="@RangeClass("year")"
                            type="button"
                            @onclick='() => SetRange("year")'>
                        Năm nay
                    </button>
                </div>
            </div>

            <div class="report-filter-grid">
                <div class="staff-form-group">
                    <label>Từ ngày</label>

                    <input class="staff-form-control"
                           type="date"
                           value="@TuNgayValue"
                           @onchange="ChangeFromDate" />
                </div>

                <div class="staff-form-group">
                    <label>Đến ngày</label>

                    <input class="staff-form-control"
                           type="date"
                           value="@DenNgayValue"
                           @onchange="ChangeToDate" />
                </div>

                <div class="staff-form-group">
                    <label>Tìm kiếm trong bảng</label>

                    <div class="mf-search report-search">
                        <span>🔍</span>

                        <input placeholder="Tên bệnh nhân, mã phiếu, thuốc..."
                               @bind="SearchText"
                               @bind:event="oninput" />
                    </div>
                </div>

                <button class="mf-btn mf-btn-primary report-apply"
                        type="button"
                        @onclick="ApplyRange">
                    Áp dụng
                </button>
            </div>

            <div class="report-period">
                Kỳ báo cáo:

                <strong>
                    @TuNgay.ToString("dd/MM/yyyy")
                </strong>

                đến

                <strong>
                    @DenNgay.ToString("dd/MM/yyyy")
                </strong>
            </div>
        </section>

        <nav class="report-tabs no-print">
            <button class="@TabClass("overview")"
                    type="button"
                    @onclick='() => SelectTab("overview")'>
                Tổng quan
            </button>

            <button class="@TabClass("exams")"
                    type="button"
                    @onclick='() => SelectTab("exams")'>
                Khám bệnh
            </button>

            <button class="@TabClass("inventory")"
                    type="button"
                    @onclick='() => SelectTab("inventory")'>
                Kho dược
            </button>

            <button class="@TabClass("revenue")"
                    type="button"
                    @onclick='() => SelectTab("revenue")'>
                Doanh thu
            </button>
        </nav>

        <div class="print-title">
            <h1>@ActiveTabTitle</h1>

            <p>
                Từ @TuNgay.ToString("dd/MM/yyyy")
                đến @DenNgay.ToString("dd/MM/yyyy")
            </p>
        </div>

        @if (ActiveTab == "overview")
        {
            <section class="report-content">
                <div class="report-metrics">
                    @foreach (ReportMetric metric in OverviewMetrics)
                    {
                        <article class="report-metric">
                            <div class="report-metric-icon @metric.ColorClass">
                                @metric.Icon
                            </div>

                            <div>
                                <span>@metric.Label</span>

                                <strong class="@metric.ValueClass">
                                    @metric.Value
                                </strong>

                                <small>@metric.Note</small>
                            </div>
                        </article>
                    }
                </div>

                <div class="report-two-columns">
                    <section class="mf-card">
                        <div class="mf-card-head">
                            <div>
                                <h2>Ca khám gần đây</h2>

                                <p>
                                    Các ca khám trong kỳ báo cáo.
                                </p>
                            </div>
                        </div>

                        <div class="report-table-wrap">
                            <table class="mf-table">
                                <thead>
                                    <tr>
                                        <th>Thời gian</th>
                                        <th>Bệnh nhân</th>
                                        <th>Bác sĩ</th>
                                        <th>Trạng thái</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @foreach (
                                        Cakham item
                                        in CaKhamTrongKy.Take(8))
                                    {
                                        <tr>
                                            <td>
                                                @FormatDate(item.NgayCT)
                                            </td>

                                            <td>
                                                @PatientName(item)
                                            </td>

                                            <td>
                                                @EmployeeName(item.Bacsi)
                                            </td>

                                            <td>
                                                <span class="@ExamStatusClass(item.TrangThai)">
                                                    @ExamStatusText(item.TrangThai)
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        @if (!CaKhamTrongKy.Any())
                        {
                            <div class="mf-empty">
                                Không có ca khám trong kỳ.
                            </div>
                        }
                    </section>

                    <section class="mf-card">
                        <div class="mf-card-head">
                            <div>
                                <h2>Cảnh báo dược liệu</h2>

                                <p>
                                    Các dược liệu cần ưu tiên nhập thêm.
                                </p>
                            </div>
                        </div>

                        <div class="report-alerts">
                            @foreach (
                                DuocLieu item
                                in DuocLieuCanNhap.Take(8))
                            {
                                <div class="report-alert-item">
                                    <div>
                                        <strong>
                                            @Text(item.TenDuocLieu)
                                        </strong>

                                        <span>
                                            Tồn @Qty(item.SoLuongTon)
                                            @Unit(item)
                                            • Tối thiểu
                                            @Qty(item.TonToiThieu)
                                        </span>
                                    </div>

                                    <span class="@StockClass(
                                                                                  item.SoLuongTon,
                                                                                  item.TonToiThieu)">
                                        @StockText(
                                            item.SoLuongTon,
                                            item.TonToiThieu)
                                    </span>
                                </div>
                            }
                        </div>

                        @if (!DuocLieuCanNhap.Any())
                        {
                            <div class="mf-empty">
                                Tồn kho dược liệu đang an toàn.
                            </div>
                        }
                    </section>
                </div>
            </section>
        }
        else if (ActiveTab == "exams")
        {
            <section class="report-content">
                <div class="report-metrics report-metrics-five">
                    @foreach (ReportMetric metric in ExamMetrics)
                    {
                        <article class="report-metric">
                            <div class="report-metric-icon @metric.ColorClass">
                                @metric.Icon
                            </div>

                            <div>
                                <span>@metric.Label</span>
                                <strong>@metric.Value</strong>
                                <small>@metric.Note</small>
                            </div>
                        </article>
                    }
                </div>

                <section class="mf-card">
                    <div class="mf-card-head">
                        <div>
                            <h2>Danh sách ca khám</h2>

                            <p>
                                Hiển thị @FilteredExams.Count()
                                trong tổng số
                                @CaKhamTrongKy.Count ca.
                            </p>
                        </div>
                    </div>

                    <div class="report-table-wrap">
                        <table class="mf-table report-wide-table">
                            <thead>
                                <tr>
                                    <th>Ngày khám</th>
                                    <th>Bệnh nhân</th>
                                    <th>Điện thoại</th>
                                    <th>Loại lượt khám</th>
                                    <th>Hình thức</th>
                                    <th>Bác sĩ</th>
                                    <th>Lý do khám</th>
                                    <th>Trạng thái</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (Cakham item in FilteredExams)
                                {
                                    <tr>
                                        <td>
                                            @FormatDate(item.NgayCT)
                                        </td>

                                        <td>
                                            @PatientName(item)
                                        </td>

                                        <td>
                                            @PatientPhone(item)
                                        </td>

                                        <td>
                                            @VisitTypeText(item.LoaiLuotKham)
                                        </td>

                                        <td>
                                            @ExamTypeText(item.LoaiCakham)
                                        </td>

                                        <td>
                                            @EmployeeName(item.Bacsi)
                                        </td>

                                        <td>
                                            @Text(item.LydoKham)
                                        </td>

                                        <td>
                                            <span class="@ExamStatusClass(item.TrangThai)">
                                                @ExamStatusText(item.TrangThai)
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    @if (!FilteredExams.Any())
                    {
                        <div class="mf-empty">
                            Không tìm thấy ca khám phù hợp.
                        </div>
                    }
                </section>
            </section>
        }
        else if (ActiveTab == "inventory")
        {
            <section class="report-content">
                <div class="report-metrics">
                    @foreach (ReportMetric metric in InventoryMetrics)
                    {
                        <article class="report-metric">
                            <div class="report-metric-icon @metric.ColorClass">
                                @metric.Icon
                            </div>

                            <div>
                                <span>@metric.Label</span>
                                <strong>@metric.Value</strong>
                                <small>@metric.Note</small>
                            </div>
                        </article>
                    }
                </div>

                <nav class="report-subtabs no-print">
                    <button class="@InventoryTabClass("herbs")"
                            type="button"
                            @onclick='() => SelectInventoryTab("herbs")'>
                        Dược liệu
                    </button>

                    <button class="@InventoryTabClass("medicines")"
                            type="button"
                            @onclick='() => SelectInventoryTab("medicines")'>
                        Thang thuốc
                    </button>

                    <button class="@InventoryTabClass("movements")"
                            type="button"
                            @onclick='() => SelectInventoryTab("movements")'>
                        Nhập / xuất kho
                    </button>
                </nav>

                @if (InventoryTab == "herbs")
                {
                    <section class="mf-card">
                        <div class="mf-card-head">
                            <div>
                                <h2>Tồn kho dược liệu</h2>

                                <p>
                                    Giá trị tồn theo giá nhập gần nhất.
                                </p>
                            </div>

                            <strong class="report-total">
                                @Money(TongGiaTriTonDuocLieu)
                            </strong>
                        </div>

                        <div class="report-table-wrap">
                            <table class="mf-table report-wide-table">
                                <thead>
                                    <tr>
                                        <th>Dược liệu</th>
                                        <th>Đơn vị</th>
                                        <th>Tồn kho</th>
                                        <th>Tồn tối thiểu</th>
                                        <th>Giá nhập</th>
                                        <th>Giá trị tồn</th>
                                        <th>Trạng thái</th>
                                        <th>Sử dụng</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @foreach (
                                        DuocLieu item
                                        in FilteredHerbs)
                                    {
                                        <tr>
                                            <td>
                                                <strong>
                                                    @Text(item.TenDuocLieu)
                                                </strong>

                                                <small class="report-code">
                                                    @HerbCode(item)
                                                </small>
                                            </td>

                                            <td>
                                                @Unit(item)
                                            </td>

                                            <td>
                                                <strong>
                                                    @Qty(item.SoLuongTon)
                                                </strong>
                                            </td>

                                            <td>
                                                @Qty(item.TonToiThieu)
                                            </td>

                                            <td>
                                                @Money(item.GiaNhapGanNhat)
                                            </td>

                                            <td>
                                                <strong>
                                                    @Money(
                                                        item.SoLuongTon *
                                                        item.GiaNhapGanNhat)
                                                </strong>
                                            </td>

                                            <td>
                                                <span class="@StockClass(
                                                                                                          item.SoLuongTon,
                                                                                                          item.TonToiThieu)">
                                                    @StockText(
                                                        item.SoLuongTon,
                                                        item.TonToiThieu)
                                                </span>
                                            </td>

                                            <td>
                                                <span class="@(item.SuDung
                                                                                                          ? "staff-status success"
                                                                                                          : "staff-status neutral")">
                                                    @(item.SuDung
                                                        ? "Đang dùng"
                                                        : "Ngừng dùng")
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        @if (!FilteredHerbs.Any())
                        {
                            <div class="mf-empty">
                                Không tìm thấy dược liệu phù hợp.
                            </div>
                        }
                    </section>
                }
                else if (InventoryTab == "medicines")
                {
                    <section class="mf-card">
                        <div class="mf-card-head">
                            <div>
                                <h2>Tồn kho thang thuốc</h2>

                                <p>
                                    Thuốc được tạo từ các dược liệu trong kho.
                                </p>
                            </div>

                            <strong class="report-total">
                                @Money(TongGiaTriTonThuoc)
                            </strong>
                        </div>

                        <div class="report-table-wrap">
                            <table class="mf-table report-wide-table">
                                <thead>
                                    <tr>
                                        <th>Thuốc / thang thuốc</th>
                                        <th>Đơn vị</th>
                                        <th>Tồn kho</th>
                                        <th>Tồn tối thiểu</th>
                                        <th>Giá nguyên liệu</th>
                                        <th>Giá bán</th>
                                        <th>Giá trị tồn</th>
                                        <th>Trạng thái</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @foreach (
                                        DanhMucThuoc item
                                        in FilteredMedicines)
                                    {
                                        <tr>
                                            <td>
                                                <strong>
                                                    @Text(item.TenThuoc)
                                                </strong>

                                                <small class="report-code">
                                                    @MedicineCode(item)
                                                </small>
                                            </td>

                                            <td>
                                                @Unit(item)
                                            </td>

                                            <td>
                                                <strong>
                                                    @Qty(item.SoLuongTon)
                                                </strong>
                                            </td>

                                            <td>
                                                @Qty(item.TonToiThieu)
                                            </td>

                                            <td>
                                                @Money(
                                                    item.GiaTinhTuDuocLieu)
                                            </td>

                                            <td>
                                                @Money(item.GiaBan)
                                            </td>

                                            <td>
                                                <strong>
                                                    @Money(
                                                        item.SoLuongTon *
                                                        item.GiaBan)
                                                </strong>
                                            </td>

                                            <td>
                                                <span class="@StockClass(
                                                                                                          item.SoLuongTon,
                                                                                                          item.TonToiThieu)">
                                                    @StockText(
                                                        item.SoLuongTon,
                                                        item.TonToiThieu)
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        @if (!FilteredMedicines.Any())
                        {
                            <div class="mf-empty">
                                Không tìm thấy thuốc phù hợp.
                            </div>
                        }
                    </section>
                }
                else
                {
                    <section class="mf-card">
                        <div class="mf-card-head">
                            <div>
                                <h2>Lịch sử nhập và xuất kho</h2>

                                <p>
                                    Các phiếu đã hoàn tất
                                    trong kỳ báo cáo.
                                </p>
                            </div>
                        </div>

                        <div class="report-table-wrap">
                            <table class="mf-table report-wide-table">
                                <thead>
                                    <tr>
                                        <th>Thời gian</th>
                                        <th>Loại phiếu</th>
                                        <th>Mã phiếu</th>
                                        <th>Đối tượng</th>
                                        <th>Nhân viên</th>
                                        <th>Giá trị</th>
                                        <th>Trạng thái</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @foreach (
                                        WarehouseMovement item
                                        in FilteredMovements)
                                    {
                                        <tr>
                                            <td>
                                                @FormatDate(item.Date)
                                            </td>

                                            <td>
                                                <span class="@(item.Type == "Nhập kho"
                                                                                                          ? "staff-status info"
                                                                                                          : "staff-status warning")">
                                                    @item.Type
                                                </span>
                                            </td>

                                            <td>
                                                <strong>
                                                    @item.Code
                                                </strong>
                                            </td>

                                            <td>
                                                @item.Subject
                                            </td>

                                            <td>
                                                @item.Employee
                                            </td>

                                            <td>
                                                <strong>
                                                    @Money(item.Value)
                                                </strong>
                                            </td>

                                            <td>
                                                <span class="staff-status success">
                                                    Hoàn tất
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        @if (!FilteredMovements.Any())
                        {
                            <div class="mf-empty">
                                Không có phiếu nhập hoặc xuất kho phù hợp.
                            </div>
                        }
                    </section>
                }
            </section>
        }
        else
        {
            <section class="report-content">
                <div class="report-metrics">
                    @foreach (ReportMetric metric in RevenueMetrics)
                    {
                        <article class="report-metric">
                            <div class="report-metric-icon @metric.ColorClass">
                                @metric.Icon
                            </div>

                            <div>
                                <span>@metric.Label</span>

                                <strong class="@metric.ValueClass">
                                    @metric.Value
                                </strong>

                                <small>@metric.Note</small>
                            </div>
                        </article>
                    }
                </div>

                <section class="mf-card">
                    <div class="mf-card-head">
                        <div>
                            <h2>Hóa đơn đã thanh toán</h2>

                            <p>
                                Hiển thị @FilteredInvoices.Count()
                                trong tổng số
                                @PaidInvoices.Count hóa đơn.
                            </p>
                        </div>
                    </div>

                    <div class="report-table-wrap">
                        <table class="mf-table report-wide-table">
                            <thead>
                                <tr>
                                    <th>Ngày thanh toán</th>
                                    <th>Mã hóa đơn</th>
                                    <th>Bệnh nhân</th>
                                    <th>Tiền thuốc</th>
                                    <th>Tiền khám</th>
                                    <th>Giảm giá</th>
                                    <th>Tổng thanh toán</th>
                                    <th>Hình thức</th>
                                    <th>Nhân viên lập</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (
                                    HoaDonBenhNhan item
                                    in FilteredInvoices)
                                {
                                    <tr>
                                        <td>
                                            @FormatDate(
                                                item.NgayThanhToan ??
                                                item.NgayLap)
                                        </td>

                                        <td>
                                            <strong>
                                                @Text(item.MaHoaDon)
                                            </strong>
                                        </td>

                                        <td>
                                            @PatientName(item)
                                        </td>

                                        <td>
                                            @Money(item.TongTienThuoc)
                                        </td>

                                        <td>
                                            @Money(item.TienKham)
                                        </td>

                                        <td>
                                            @Money(item.GiamGia)
                                        </td>

                                        <td>
                                            <strong>
                                                @Money(item.TongThanhToan)
                                            </strong>
                                        </td>

                                        <td>
                                            <span class="staff-status info">
                                                @PaymentText(
                                                    item.HinhThucThanhToan)
                                            </span>
                                        </td>

                                        <td>
                                            @EmployeeName(item.NhanVienLap)
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    @if (!FilteredInvoices.Any())
                    {
                        <div class="mf-empty">
                            Không tìm thấy hóa đơn phù hợp.
                        </div>
                    }
                </section>
            </section>
        }
    </main>
</div>

@code {
    private IObjectSpace objectSpace;

    private DateTime TuNgay = DateTime.Today;
    private DateTime DenNgay = DateTime.Today;

    private string QuickRange = "today";
    private string ActiveTab = "overview";
    private string InventoryTab = "herbs";
    private string SearchText = string.Empty;

    private string Message = string.Empty;

    private string MessageClass =
        "mf-alert mf-alert-success";

    private List<Cakham> Exams = new();
    private List<DuocLieu> Herbs = new();
    private List<DanhMucThuoc> Medicines = new();
    private List<PhieuNhapKho> Imports = new();
    private List<PhieuXuatKho> Exports = new();
    private List<HoaDonBenhNhan> Invoices = new();

    private DateTime RangeStart =>
        TuNgay.Date;

    private DateTime RangeEnd =>
        DenNgay.Date.AddDays(1);

    private string TuNgayValue =>
        TuNgay.ToString("yyyy-MM-dd");

    private string DenNgayValue =>
        DenNgay.ToString("yyyy-MM-dd");

    private string ActiveTabTitle =>
        ActiveTab switch
        {
            "exams" => "Báo cáo khám bệnh",
            "inventory" => "Báo cáo kho dược",
            "revenue" => "Báo cáo doanh thu",
            _ => "Báo cáo tổng quan"
        };

    private List<Cakham> CaKhamTrongKy =>
        Exams
            .Where(x => InRange(x.NgayCT))
            .OrderByDescending(x => x.NgayCT)
            .ToList();

    private IEnumerable<Cakham> FilteredExams =>
        CaKhamTrongKy.Where(x =>
            Match(
                PatientName(x),
                PatientPhone(x),
                x.TenCaKham,
                x.LydoKham,
                EmployeeName(x.Bacsi),
                ExamStatusText(x.TrangThai),
                VisitTypeText(x.LoaiLuotKham)
            )
        );

    private List<PhieuNhapKho> CompletedImports =>
        Imports
            .Where(x =>
                x.TrangThai ==
                    TrangThaiPhieuNhapKho.DaNhap &&
                InRange(x.NgayNhap)
            )
            .OrderByDescending(x => x.NgayNhap)
            .ToList();

    private List<PhieuXuatKho> CompletedExports =>
        Exports
            .Where(x =>
                x.TrangThai ==
                    TrangThaiPhieuXuatKho.DaXuat &&
                InRange(x.NgayXuat)
            )
            .OrderByDescending(x => x.NgayXuat)
            .ToList();

    private List<HoaDonBenhNhan> PaidInvoices =>
        Invoices
            .Where(x =>
                x.TrangThai ==
                    TrangThaiHoaDonBenhNhan.DaThanhToan &&

                InRange(
                    x.NgayThanhToan ??
                    x.NgayLap
                )
            )
            .OrderByDescending(x =>
                x.NgayThanhToan ??
                x.NgayLap
            )
            .ToList();

    private IEnumerable<HoaDonBenhNhan> FilteredInvoices =>
        PaidInvoices.Where(x =>
            Match(
                x.MaHoaDon,
                PatientName(x),
                PaymentText(x.HinhThucThanhToan),
                EmployeeName(x.NhanVienLap)
            )
        );

    private List<DuocLieu> DuocLieuCanNhap =>
        Herbs
            .Where(x =>
                x.SuDung &&
                x.SoLuongTon <= x.TonToiThieu
            )
            .OrderBy(x => x.SoLuongTon)
            .ThenBy(x => x.TenDuocLieu)
            .ToList();

    private List<DanhMucThuoc> ThuocCanBoSung =>
        Medicines
            .Where(x =>
                x.SuDung &&
                x.SoLuongTon <= x.TonToiThieu
            )
            .OrderBy(x => x.SoLuongTon)
            .ThenBy(x => x.TenThuoc)
            .ToList();

    private IEnumerable<DuocLieu> FilteredHerbs =>
        Herbs
            .Where(x =>
                Match(
                    x.MaDuocLieu,
                    x.TenDuocLieu,
                    Unit(x),
                    StockText(
                        x.SoLuongTon,
                        x.TonToiThieu
                    )
                )
            )
            .OrderBy(x => x.TenDuocLieu);

    private IEnumerable<DanhMucThuoc> FilteredMedicines =>
        Medicines
            .Where(x =>
                Match(
                    x.MaThuoc,
                    x.TenThuoc,
                    Unit(x),
                    StockText(
                        x.SoLuongTon,
                        x.TonToiThieu
                    )
                )
            )
            .OrderBy(x => x.TenThuoc);

    private List<WarehouseMovement> Movements
    {
        get
        {
            List<WarehouseMovement> rows =
                CompletedImports
                    .Select(x =>
                        new WarehouseMovement
                        {
                            Date = x.NgayNhap,
                            Type = "Nhập kho",
                            Code = Text(x.MaPhieuNhap),
                            Subject = Text(x.NhaCungCap),
                            Employee =
                                EmployeeName(x.NhanVien),
                            Value = x.TongTien
                        }
                    )
                    .ToList();

            rows.AddRange(
                CompletedExports.Select(x =>
                    new WarehouseMovement
                    {
                        Date = x.NgayXuat,
                        Type = "Xuất kho",
                        Code = Text(x.MaPhieuXuat),
                        Subject = PatientName(x),
                        Employee =
                            EmployeeName(x.NhanVien),
                        Value = x.TongTien
                    }
                )
            );

            return rows
                .OrderByDescending(x => x.Date)
                .ToList();
        }
    }

    private IEnumerable<WarehouseMovement> FilteredMovements =>
        Movements.Where(x =>
            Match(
                x.Type,
                x.Code,
                x.Subject,
                x.Employee
            )
        );

