    }

    private string GetNguTaPart(int index)
    {
        if (CaKham == null)
        {
            return "";
        }

        string raw =
            CaKham.NguTaSoDo ?? "";

        string[] parts =
            raw.Split('|');

        if (parts.Length <= index)
        {
            return "";
        }

        return parts[index];
    }

    private string GetPropertyText(
        object obj,
        string propertyName)
    {
        if (obj == null)
        {
            return "--";
        }

        PropertyInfo prop =
            obj.GetType()
                .GetProperty(propertyName);

        if (prop == null)
        {
            return "--";
        }

        object value =
            prop.GetValue(obj);

        if (value == null)
        {
            return "--";
        }

        if (value is DateTime date)
        {
            return date == DateTime.MinValue
                ? "--"
                : date.ToString(
                    "dd/MM/yyyy HH:mm"
                );
        }

        if (value is decimal money)
        {
            return money.ToString("n0");
        }

        return value.ToString();
    }

    private int GetCollectionCount(
        object obj,
        string propertyName)
    {
        if (obj == null)
        {
            return 0;
        }

        PropertyInfo prop =
            obj.GetType()
                .GetProperty(propertyName);

        if (prop == null)
        {
            return 0;
        }

        object value =
            prop.GetValue(obj);

        if (value is ICollection collection)
        {
            return collection.Count;
        }

        if (value is IEnumerable enumerable)
        {
            int count = 0;

            foreach (object item in enumerable)
            {
                count++;
            }

            return count;
        }

        return 0;
    }

    private string GetInitials(string fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName))
        {
            return "BS";
        }

        string[] parts =
            fullName.Split(
                ' ',
                StringSplitOptions.RemoveEmptyEntries
            );

        if (parts.Length == 1)
        {
            return parts[0]
                .Substring(
                    0,
                    Math.Min(2, parts[0].Length)
                )
                .ToUpperInvariant();
        }

        return
            $"{parts[0][0]}{parts[^1][0]}"
                .ToUpperInvariant();
    }

