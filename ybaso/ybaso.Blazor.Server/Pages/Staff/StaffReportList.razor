    {
        if (item?.BenhNhan != null &&
            !string.IsNullOrWhiteSpace(
                item.BenhNhan.HoTen))
        {
            return item.BenhNhan.HoTen;
        }

        return Text(
            item?.TenBenhNhanGon
        );
    }

    private string PatientPhone(
