@page "/patient/exams/new"
@page "/patient/exams/self/{Oid:int}"

@using System.Linq
@using DevExpress.ExpressApp
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components
@using ybaso.Blazor.Server.Services
@using ybaso.Module.BusinessObjects
@implements IDisposable

@attribute [Authorize(Roles = "BenhNhan")]

@inject IObjectSpaceFactory ObjectSpaceFactory
@inject CurrentPatientService CurrentPatientService
@inject PatientSelfExamService PatientSelfExamService
@inject NavigationManager Navigation

<PageTitle>Ca khám của tôi</PageTitle>

<div class="patient-page">
    <PatientSidebar ActiveMenu="exam-create"
                    DisplayName="@SidebarName" />

    <main class="patient-main">

        @if (IsLoading)
        {
            <section class="patient-loading">
                <div class="patient-loading-spinner"></div>

                <strong>Đang chuẩn bị ca khám...</strong>

                <span>
                    Hệ thống đang xác định hồ sơ bệnh nhân
                    thuộc tài khoản hiện tại.
                </span>
            </section>
        }
        else if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <section class="patient-message-card error">
                <div class="patient-message-icon">
                    ⚠️
                </div>

                <div>
                    <h2>Không thể tải ca khám</h2>

                    <p>@ErrorMessage</p>

                    <div class="patient-selfexam-error-actions">
                        <button class="patient-btn patient-btn-outline"
                                type="button"
                                @onclick="GoHome">
                            Về trang chủ
                        </button>

                        <button class="patient-btn patient-btn-primary"
                                type="button"
                                @onclick="ReloadPage">
                            Thử lại
                        </button>
                    </div>
                </div>
            </section>
        }
        else if (CurrentPatient == null)
        {
            <section class="patient-message-card warning">
                <div class="patient-message-icon">
                    🔗
                </div>

                <div>
                    <h2>Tài khoản chưa liên kết hồ sơ</h2>

                    <p>
                        Tài khoản <strong>@CurrentUserName</strong>
                        chưa được liên kết với hồ sơ bệnh nhân.
                    </p>

                    <p>
                        Bạn chỉ có thể tạo ca khám cho hồ sơ
                        được liên kết với chính tài khoản của mình.
                    </p>

                    <button class="patient-btn patient-btn-outline"
                            type="button"
                            @onclick="GoHome">
                        Quay lại trang chủ
                    </button>
                </div>
            </section>
        }
        else if (Oid <= 0)
        {
            <!-- =====================================================
                 BƯỚC 1: TẠO CA KHÁM
                 ===================================================== -->

            <header class="patient-selfexam-header">
                <div>
                    <span class="patient-eyebrow">
                        Khám bệnh
                    </span>

                    <h1>Tạo ca khám mới</h1>

                    <p>
                        Nhập thông tin cơ bản trước khi tiến hành
                        đo 12 tinh huyệt.
                    </p>
                </div>

                <div class="patient-header-actions">
                    <button class="patient-btn patient-btn-outline"
                            type="button"
                            disabled="@IsProcessing"
                            @onclick="GoExamHistory">
                        Lịch sử khám
                    </button>

                    <button class="patient-btn patient-btn-primary"
                            type="button"
                            disabled="@IsProcessing"
                            @onclick="CreateExam">
                        @(IsProcessing
                            ? "Đang tạo..."
                            : "Tiếp tục nhập số đo →")
                    </button>
                </div>
            </header>

            <section class="patient-selfexam-warning">
                <div class="patient-selfexam-warning-icon">
                    ⚕️
                </div>

                <div>
                    <strong>Kết quả chỉ mang tính tham khảo</strong>

                    <p>
                        Chẩn đoán và pháp trị tự động phải được bác sĩ
                        kiểm tra trước khi sử dụng để điều trị.
                        Bệnh nhân không có quyền tạo đơn thuốc.
                    </p>
                </div>
            </section>

            @if (!string.IsNullOrWhiteSpace(ActionMessage))
            {
                <div class="@ActionMessageClass">
                    @ActionMessage
                </div>
            }

            <section class="patient-selfexam-create-grid">
                <article class="patient-card patient-selfexam-patient-card">
                    <div class="patient-card-header">
                        <div>
                            <h2>Hồ sơ thực hiện khám</h2>

                            <p>
                                Hệ thống tự động sử dụng hồ sơ
                                của tài khoản hiện tại.
                            </p>
                        </div>

                        <div class="patient-section-icon blue">
                            👤
                        </div>
                    </div>

                    <div class="patient-selfexam-patient">
                        <div class="patient-selfexam-avatar">
                            @GetInitials(CurrentPatient.HoTen)
                        </div>

                        <div>
                            <span>Bệnh nhân</span>

                            <strong>
                                @Text(CurrentPatient.HoTen)
                            </strong>

                            <small>
                                @GenderText(CurrentPatient.Gioitinh)
                                •
                                @AgeText(CurrentPatient.Ngaysinh)
                                •
                                @Text(CurrentPatient.Dienthoai)
                            </small>
                        </div>
                    </div>

                    <div class="patient-selfexam-system-info">
                        <div>
                            <span>Hình thức khám</span>
                            <strong>Từ xa / Tự nhập số đo</strong>
                        </div>

                        <div>
                            <span>Bác sĩ phụ trách</span>
                            <strong>Chờ phòng khám phân công</strong>
                        </div>

                        <div>
                            <span>Trạng thái ban đầu</span>
                            <strong>Chờ khám</strong>
                        </div>
                    </div>
                </article>

                <article class="patient-card patient-selfexam-form-card">
                    <div class="patient-card-header">
                        <div>
                            <h2>Thông tin ca khám</h2>

                            <p>
                                Vui lòng nhập đầy đủ các thông tin
                                trước khi chuyển sang bước số đo.
                            </p>
                        </div>

                        <div class="patient-section-icon cyan">
                            🩺
                        </div>
                    </div>

                    <div class="patient-selfexam-form">
                        <div class="patient-selfexam-field">
                            <label>
                                Chiều cao (cm)
                                <span>*</span>
                            </label>

                            <input type="number"
                                   min="50"
                                   max="250"
                                   step="0.1"
                                   disabled="@IsProcessing"
                                   @bind="Height" />
                        </div>

                        <div class="patient-selfexam-field">
                            <label>
                                Cân nặng (kg)
                                <span>*</span>
                            </label>

                            <input type="number"
                                   min="5"
                                   max="300"
                                   step="0.1"
                                   disabled="@IsProcessing"
                                   @bind="Weight" />
                        </div>

                        <div class="patient-selfexam-field">
                            <label>
                                Nhiệt độ môi trường (°C)
                                <span>*</span>
                            </label>

                            <input type="number"
                                   min="0"
                                   max="50"
                                   step="0.1"
                                   disabled="@IsProcessing"
                                   @bind="EnvironmentTemperature" />
                        </div>

                        <div class="patient-selfexam-field">
                            <label>BMI dự kiến</label>

                            <input value="@BmiText"
                                   readonly />
                        </div>

                        <div class="patient-selfexam-field full">
                            <label>
                                Lý do khám
                                <span>*</span>
                            </label>

                            <textarea rows="5"
                                      maxlength="2000"
                                      disabled="@IsProcessing"
                                      placeholder="Mô tả triệu chứng, thời gian xuất hiện và tình trạng hiện tại..."
                                      @bind="Reason">
                            </textarea>

                            <small>
                                Ví dụ: đau đầu, mất ngủ, mệt mỏi,
                                đau lưng hoặc ăn uống kém.
                            </small>
                        </div>

                        <div class="patient-selfexam-form-actions">
                            <button class="patient-btn patient-btn-outline"
                                    type="button"
                                    disabled="@IsProcessing"
                                    @onclick="GoHome">
                                Hủy
                            </button>

                            <button class="patient-btn patient-btn-primary"
                                    type="button"
                                    disabled="@IsProcessing"
                                    @onclick="CreateExam">
                                @(IsProcessing
                                    ? "Đang tạo ca khám..."
                                    : "Tạo ca khám và nhập số đo")
                            </button>
                        </div>
                    </div>
                </article>
            </section>
        }
        else if (CurrentExam == null)
        {
            <section class="patient-exam-denied">
                <div class="patient-exam-denied-icon">
                    🔒
                </div>

                <h1>Không thể truy cập ca khám</h1>

                <p>
                    Ca khám không tồn tại hoặc không thuộc
                    hồ sơ bệnh nhân đang đăng nhập.
                </p>

                <div class="patient-exam-denied-actions">
                    <button class="patient-btn patient-btn-outline"
                            type="button"
                            @onclick="GoHome">
                        Về trang chủ
                    </button>

                    <button class="patient-btn patient-btn-primary"
                            type="button"
                            @onclick="GoCreateNewExam">
                        Tạo ca khám mới
                    </button>
                </div>
            </section>
        }
        else
        {
            <!-- =====================================================
                 KHÔNG GIAN CA KHÁM ĐÃ TẠO
                 ===================================================== -->

            <header class="patient-selfexam-header">
                <div>
                    <button class="patient-back-button"
                            type="button"
                            @onclick="GoExamHistory">
                        ← Quay lại lịch sử khám
                    </button>

                    <span class="patient-eyebrow">
                        Ca khám tự nhập
                    </span>

                    <h1>
                        @ExamTitle
                    </h1>

                    <p>
                        Nhập số đo, chạy phân tích và gửi kết quả
                        để bác sĩ kiểm tra.
                    </p>
                </div>

                <div class="patient-selfexam-header-actions">
                    <span class="@ExamStatusClass(CurrentExam.TrangThai)">
                        @ExamStatusText(CurrentExam.TrangThai)
                    </span>

                    <button class="patient-btn patient-btn-outline"
                            type="button"
                            disabled="@IsProcessing"
                            @onclick="ReloadPage">
                        Làm mới
                    </button>
                </div>
            </header>

            <section class="patient-selfexam-exam-banner">
                <div class="patient-selfexam-exam-code">
                    <span>Ca khám</span>
                    <strong>#@CurrentExam.Oid</strong>
                </div>

                <div class="patient-selfexam-exam-summary">
                    <div>
                        <span>Bệnh nhân</span>
                        <strong>@CurrentPatient.HoTen</strong>
                    </div>

                    <div>
                        <span>Ngày tạo</span>
                        <strong>
                            @CurrentExam.NgayCT.ToString(
                                "HH:mm, dd/MM/yyyy")
                        </strong>
                    </div>

                    <div>
                        <span>Hình thức</span>
                        <strong>Từ xa</strong>
                    </div>

                    <div>
                        <span>Bác sĩ</span>
                        <strong>
                            @(CurrentExam.Bacsi == null
                                ? "Chưa phân công"
                                : CurrentExam.Bacsi.HoTen)
                        </strong>
                    </div>
                </div>
            </section>

            <section class="patient-selfexam-disclaimer">
                <span>⚠️</span>

                <div>
                    <strong>
                        Chẩn đoán và pháp trị tự động chưa phải
                        kết luận cuối cùng
                    </strong>

                    <p>
                        Bác sĩ cần kiểm tra số đo và xác nhận chuyên môn.
                        Không tự ý mua thuốc hoặc điều trị dựa trên
                        kết quả tự động.
                    </p>
                </div>
            </section>

            @if (!string.IsNullOrWhiteSpace(ActionMessage))
            {
                <div class="@ActionMessageClass">
                    @ActionMessage
                </div>
            }

            <section class="patient-card patient-selfexam-workspace">
                <div class="patient-selfexam-tabs">
                    <button class="@GetTabClass("info")"
                            type="button"
                            @onclick='() => SetTab("info")'>
                        <span>①</span>
                        Thông tin
                    </button>

                    <button class="@GetTabClass("measurements")"
                            type="button"
                            @onclick='() => SetTab("measurements")'>
                        <span>②</span>
                        Nhập số đo
                    </button>

                    <button class="@GetTabClass("results")"
                            type="button"
                            @onclick='() => SetTab("results")'>
                        <span>③</span>
                        Kết quả phân tích
                    </button>
                </div>

                <div class="patient-selfexam-workspace-body">

                    @if (ActiveTab == "info")
                    {
                        <section class="patient-selfexam-section">
                            <div class="patient-selfexam-section-head">
                                <div>
                                    <h2>Thông tin ca khám</h2>

                                    <p>
                                        Bạn chỉ được cập nhật thông tin
                                        khi ca khám chưa được bác sĩ tiếp nhận.
                                    </p>
                                </div>

                                @if (CanEditExam)
                                {
                                    <button class="patient-btn patient-btn-primary"
                                            type="button"
                                            disabled="@IsProcessing"
                                            @onclick="SaveExamInformation">
                                        @(IsProcessing
                                            ? "Đang lưu..."
                                            : "💾 Lưu thông tin")
                                    </button>
                                }
                            </div>

                            <div class="patient-selfexam-form">
                                <div class="patient-selfexam-field">
                                    <label>Chiều cao (cm)</label>

                                    <input type="number"
                                           min="50"
                                           max="250"
                                           step="0.1"
                                           disabled="@(!CanEditExam || IsProcessing)"
                                           @bind="Height" />
                                </div>

                                <div class="patient-selfexam-field">
                                    <label>Cân nặng (kg)</label>

                                    <input type="number"
                                           min="5"
                                           max="300"
                                           step="0.1"
                                           disabled="@(!CanEditExam || IsProcessing)"
                                           @bind="Weight" />
                                </div>

                                <div class="patient-selfexam-field">
                                    <label>Nhiệt độ môi trường (°C)</label>

                                    <input type="number"
                                           min="0"
                                           max="50"
                                           step="0.1"
                                           disabled="@(!CanEditExam || IsProcessing)"
                                           @bind="EnvironmentTemperature" />
                                </div>

                                <div class="patient-selfexam-field">
                                    <label>BMI</label>

                                    <input value="@BmiText"
                                           readonly />
                                </div>

                                <div class="patient-selfexam-field full">
                                    <label>Lý do khám</label>

                                    <textarea rows="5"
                                              maxlength="2000"
                                              disabled="@(!CanEditExam || IsProcessing)"
                                              @bind="Reason">
                                    </textarea>
                                </div>
                            </div>

                            @if (!CanEditExam)
                            {
                                <div class="patient-selfexam-locked">
                                    <span>🔒</span>

                                    <div>
                                        <strong>Ca khám đã bị khóa chỉnh sửa</strong>

                                        <p>
                                            Phòng khám đã tiếp nhận hoặc hoàn tất
                                            ca khám này.
                                        </p>
                                    </div>
                                </div>
                            }
                        </section>
                    }

                    @if (ActiveTab == "measurements")
                    {
                        <section class="patient-selfexam-section">
                            <div class="patient-selfexam-section-head">
                                <div>
                                    <h2>Nhập 12 cặp số đo tinh huyệt</h2>

                                    <p>
                                        Nhập đầy đủ giá trị bên trái và bên phải,
                                        sau đó bấm phân tích.
                                    </p>
                                </div>

                                @if (CanEditExam)
                                {
                                    <div class="patient-selfexam-section-actions">
                                        <button class="patient-btn patient-btn-outline"
                                                type="button"
                                                disabled="@IsProcessing"
                                                @onclick="SaveMeasurements">
                                            💾 Lưu số đo
                                        </button>

                                        <button class="patient-btn patient-btn-primary"
                                                type="button"
                                                disabled="@IsProcessing"
                                                @onclick="AnalyzeMeasurements">
                                            @(IsProcessing
                                                ? "Đang phân tích..."
                                                : "🔄 Phân tích chẩn đoán")
                                        </button>
                                    </div>
                                }
                            </div>

                            <div class="patient-selfexam-measure-note">
                                <span>ℹ️</span>

                                <p>
                                    Chỉ nhập số đo do thiết bị tại phòng khám
                                    cung cấp. Không tự ước lượng giá trị.
                                </p>
                            </div>

                            <div class="patient-selfexam-measure-grid">
                                <article class="patient-selfexam-measure-panel">
                                    <div class="patient-selfexam-measure-title">
                                        <div>
                                            <span>✋</span>

                                            <div>
                                                <strong>Chi trên</strong>
                                                <small>Tinh huyệt từ 1 đến 6</small>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="patient-selfexam-table-wrap">
                                        <table class="patient-selfexam-measure-table">
                                            <thead>
                                                <tr>
                                                    <th>TT</th>
                                                    <th>Tinh huyệt</th>
                                                    <th>Trái</th>
                                                    <th>Phải</th>
                                                    <th>Trung bình</th>
                                                </tr>
                                            </thead>

                                            <tbody>
                                                @foreach (
                                                    MeasurementRowModel item
                                                    in UpperMeasurements)
                                                {
                                                    <tr @key="item.TT">
                                                        <td>
                                                            <span class="patient-selfexam-order">
                                                                @item.TT
                                                            </span>
                                                        </td>

                                                        <td>
                                                            <strong>
                                                                @item.TinhHuyet
                                                            </strong>
                                                        </td>

                                                        <td>
                                                            <input class="patient-selfexam-measure-input"
                                                                   type="number"
                                                                   min="0"
                                                                   max="500"
                                                                   step="0.1"
                                                                   disabled="@(!CanEditExam || IsProcessing)"
                                                                   @bind="item.Trai" />
                                                        </td>

                                                        <td>
                                                            <input class="patient-selfexam-measure-input"
                                                                   type="number"
                                                                   min="0"
                                                                   max="500"
                                                                   step="0.1"
                                                                   disabled="@(!CanEditExam || IsProcessing)"
                                                                   @bind="item.Phai" />
                                                        </td>

                                                        <td>
                                                            @item.Average.ToString("0.##")
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </article>

                                <article class="patient-selfexam-measure-panel">
                                    <div class="patient-selfexam-measure-title">
                                        <div>
                                            <span>🦶</span>

                                            <div>
                                                <strong>Chi dưới</strong>
                                                <small>Tinh huyệt từ 7 đến 12</small>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="patient-selfexam-table-wrap">
                                        <table class="patient-selfexam-measure-table">
                                            <thead>
                                                <tr>
                                                    <th>TT</th>
                                                    <th>Tinh huyệt</th>
                                                    <th>Trái</th>
                                                    <th>Phải</th>
                                                    <th>Trung bình</th>
                                                </tr>
                                            </thead>

                                            <tbody>
                                                @foreach (
                                                    MeasurementRowModel item
                                                    in LowerMeasurements)
                                                {
                                                    <tr @key="item.TT">
                                                        <td>
                                                            <span class="patient-selfexam-order">
                                                                @item.TT
                                                            </span>
                                                        </td>

                                                        <td>
                                                            <strong>
                                                                @item.TinhHuyet
                                                            </strong>
                                                        </td>

                                                        <td>
                                                            <input class="patient-selfexam-measure-input"
                                                                   type="number"
                                                                   min="0"
                                                                   max="500"
                                                                   step="0.1"
                                                                   disabled="@(!CanEditExam || IsProcessing)"
                                                                   @bind="item.Trai" />
                                                        </td>

                                                        <td>
                                                            <input class="patient-selfexam-measure-input"
                                                                   type="number"
                                                                   min="0"
                                                                   max="500"
                                                                   step="0.1"
                                                                   disabled="@(!CanEditExam || IsProcessing)"
                                                                   @bind="item.Phai" />
                                                        </td>

                                                        <td>
                                                            @item.Average.ToString("0.##")
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </article>
                            </div>

                            @if (CanEditExam)
                            {
                                <div class="patient-selfexam-bottom-actions">
                                    <button class="patient-btn patient-btn-outline"
                                            type="button"
                                            disabled="@IsProcessing"
                                            @onclick="SaveMeasurements">
                                        💾 Lưu số đo
                                    </button>

                                    <button class="patient-btn patient-btn-primary"
                                            type="button"
                                            disabled="@IsProcessing"
                                            @onclick="AnalyzeMeasurements">
                                        @(IsProcessing
                                            ? "Đang phân tích..."
                                            : "Phân tích và xem pháp trị →")
                                    </button>
                                </div>
                            }
                        </section>
                    }

                    @if (ActiveTab == "results")
                    {
                        <section class="patient-selfexam-section">
                            <div class="patient-selfexam-section-head">
                                <div>
                                    <h2>Kết quả phân tích tự động</h2>

                                    <p>
                                        Kết quả được tạo từ 12 cặp số đo
                                        và cần bác sĩ xác nhận.
                                    </p>
                                </div>

                                @if (CanEditExam)
                                {
                                    <button class="patient-btn patient-btn-primary"
                                            type="button"
                                            disabled="@IsProcessing"
                                            @onclick="AnalyzeMeasurements">
                                        🔄 Phân tích lại
                                    </button>
                                }
                            </div>

                            @if (!HasAnalysisResult)
                            {
                                <div class="patient-empty-state">
                                    <div>📊</div>

                                    <strong>Chưa có kết quả phân tích</strong>

                                    <p>
                                        Hãy nhập đầy đủ 12 cặp số đo,
                                        sau đó bấm “Phân tích chẩn đoán”.
                                    </p>

                                    <button class="patient-btn patient-btn-outline patient-empty-button"
                                            type="button"
                                            @onclick='() => SetTab("measurements")'>
                                        Quay lại nhập số đo
                                    </button>
                                </div>
                            }
                            else
                            {
                                <div class="patient-selfexam-result-warning">
                                    <span>⚠️</span>

                                    <div>
                                        <strong>
                                            Chưa được bác sĩ xác nhận
                                        </strong>

                                        <p>
