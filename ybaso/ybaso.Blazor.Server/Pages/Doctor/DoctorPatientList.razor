@page "/doctor/patients"

@using DevExpress.ExpressApp
@using Microsoft.AspNetCore.Components.Authorization
@using ybaso.Module.BusinessObjects
@implements IDisposable

@inject IObjectSpaceFactory ObjectSpaceFactory
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider

<div class="doctor-page">

    <DoctorSidebar />

    <main class="doctor-main">
        <header class="mf-topbar">
            <div>
                <h1>Danh sách bệnh nhân</h1>
                <p>Quản lý hồ sơ bệnh nhân, tạo ca khám nhanh và theo dõi thông tin cơ bản.</p>
            </div>

            <div class="mf-actions">
                <div class="mf-search">
                    <span>🔍</span>
                    <input placeholder="Tìm tên, số điện thoại, email..."
                           @bind="SearchText"
                           @bind:event="oninput" />
                </div>

                <button class="mf-btn mf-btn-outline" @onclick="ReloadData">
                    Làm mới
                </button>

                <button class="mf-btn mf-btn-primary" @onclick="CreatePatient">
                    + Thêm bệnh nhân
                </button>
            </div>
        </header>

        @if (!string.IsNullOrWhiteSpace(Message))
        {
            <div class="@MessageClass">
                @Message
            </div>
        }

        <section class="doctor-stats">
            <div class="doctor-stat-card">
                <div class="doctor-stat-icon blue">👥</div>
                <div>
                    <p>Tổng bệnh nhân</p>
                    <h3>@TongBenhNhan</h3>
                </div>
            </div>

            <div class="doctor-stat-card">
                <div class="doctor-stat-icon green">🩺</div>
                <div>
                    <p>Đã có ca khám</p>
                    <h3>@BenhNhanCoCaKham</h3>
                </div>
            </div>

            <div class="doctor-stat-card">
                <div class="doctor-stat-icon orange">📋</div>
                <div>
                    <p>Đang hiển thị</p>
                    <h3>@DanhSachLoc.Count()</h3>
                </div>
            </div>

            <div class="doctor-stat-card">
                <div class="doctor-stat-icon purple">📅</div>
                <div>
                    <p>Ca khám hôm nay</p>
                    <h3>@CaKhamHomNay</h3>
                </div>
            </div>
        </section>

        <section class="mf-card">
            <div class="mf-card-head">
                <div>
                    <h2>Bệnh nhân</h2>
                    <p>Hiển thị @DanhSachLoc.Count() trong tổng số @TongBenhNhan bệnh nhân.</p>
                </div>
            </div>

            <table class="mf-table">
                <thead>
                    <tr>
                        <th>Họ tên</th>
                        <th>Ngày sinh</th>
                        <th>Giới tính</th>
                        <th>Điện thoại</th>
                        <th>Email</th>
                        <th>Số CCCD/CMND</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in DanhSachLoc)
                    {
                        <tr>
                            <td>
                                <div class="doctor-cell-main">
                                    <div class="doctor-circle">
                                        @GetInitials(item.HoTen)
                                    </div>

                                    <div>
                                        <strong>@item.HoTen</strong>
                                        <small>ID: BN-@item.Oid.ToString("0000")</small>
                                    </div>
                                </div>
                            </td>

                            <td>@FormatDate(item.Ngaysinh)</td>
                            <td>@GetGioiTinh(item)</td>
                            <td>@EmptyText(item.Dienthoai)</td>
                            <td>@EmptyText(item.Email)</td>
                            <td>@EmptyText(item.SoCMND)</td>

                            <td>
                                <button class="doctor-table-btn" @onclick="() => OpenPatient(item.Oid)">
                                    Hồ sơ
                                </button>

                                <button class="doctor-table-btn light" @onclick="() => CreateExamForPatient(item.Oid)">
                                    Tạo ca khám
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            @if (!DanhSachLoc.Any())
            {
                <div class="mf-empty">
                    Không tìm thấy bệnh nhân phù hợp.
                </div>
            }
        </section>
    </main>
</div>

@code {
    private IObjectSpace objectSpace;

    private string CurrentUserName = "Bác sĩ";
    private string SearchText = "";

    private string Message = "";
    private string MessageClass = "mf-alert mf-alert-success";

    private List<Benhnhan> DanhSachBenhNhan = new();
    private List<Cakham> DanhSachCaKham = new();

    private int TongBenhNhan => DanhSachBenhNhan.Count;

    private int BenhNhanCoCaKham
    {
        get
        {
            return DanhSachCaKham
                .Where(x => x.BenhNhan != null)
                .Select(x => x.BenhNhan.Oid)
                .Distinct()
                .Count();
        }
    }

    private int CaKhamHomNay
    {
        get
        {
            return DanhSachCaKham.Count(x => x.NgayCT.Date == DateTime.Today);
        }
    }

    private IEnumerable<Benhnhan> DanhSachLoc
    {
        get
        {
            IEnumerable<Benhnhan> query = DanhSachBenhNhan
                .OrderBy(x => x.Ten)
                .ThenBy(x => x.Ho);

            if (string.IsNullOrWhiteSpace(SearchText))
                return query;

            string keyword = SearchText.Trim().ToLowerInvariant();

            return query.Where(x =>
                (x.HoTen ?? "").ToLowerInvariant().Contains(keyword) ||
                (x.Dienthoai ?? "").ToLowerInvariant().Contains(keyword) ||
                (x.Email ?? "").ToLowerInvariant().Contains(keyword) ||
                (x.SoCMND ?? "").ToLowerInvariant().Contains(keyword)
            );
        }
    }

    protected override async Task OnInitializedAsync()
    {
        objectSpace = ObjectSpaceFactory.CreateObjectSpace(typeof(Benhnhan));

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        CurrentUserName = authState.User?.Identity?.Name ?? "Bác sĩ";

        LoadData();
    }

    private void LoadData()
    {
        DanhSachBenhNhan = objectSpace.GetObjects<Benhnhan>()
            .OrderBy(x => x.Ten)
            .ThenBy(x => x.Ho)
            .ToList();

        DanhSachCaKham = objectSpace.GetObjects<Cakham>()
            .OrderByDescending(x => x.NgayCT)
            .ToList();
    }

    private void ReloadData()
    {
        objectSpace.Refresh();
        LoadData();

        MessageClass = "mf-alert mf-alert-success";
        Message = "Đã làm mới danh sách bệnh nhân.";
    }

    private void CreatePatient()
    {
        Navigation.NavigateTo("/doctor/patients/new");
    }

    private void OpenPatient(int oid)
    {
        Navigation.NavigateTo($"/doctor/patients/edit/{oid}");
    }

    private void CreateExamForPatient(int benhNhanOid)
    {
        try
        {
            Benhnhan benhNhan = objectSpace.GetObjectByKey<Benhnhan>(benhNhanOid);

            if (benhNhan == null)
            {
                MessageClass = "mf-alert mf-alert-danger";
                Message = "Không tìm thấy bệnh nhân để tạo ca khám.";
                return;
            }

            Cakham caKham = objectSpace.CreateObject<Cakham>();

            caKham.BenhNhan = benhNhan;
            caKham.NgayCT = DateTime.Now;
            caKham.TrangThai = TrangThaiCaKham.ChoKham;
            caKham.LoaiCakham = LoaiCaKham.TrucTiep;
            caKham.LoaiLuotKham = LoaiLuotKham.BenhNhanCu;
            caKham.NhietDoMoiTruong = 26.3;
            caKham.Tuoi = TinhTuoi(benhNhan.Ngaysinh);

            objectSpace.CommitChanges();

            Navigation.NavigateTo($"/doctor/exams/{caKham.Oid}");
        }
        catch (Exception ex)
        {
            MessageClass = "mf-alert mf-alert-danger";
            Message = "Lỗi khi tạo ca khám: " + ex.Message;
        }
    }

    private int TinhTuoi(DateTime ngaySinh)
    {
        if (ngaySinh == DateTime.MinValue)
            return 0;

        int tuoi = DateTime.Today.Year - ngaySinh.Year;

        if (ngaySinh.Date > DateTime.Today.AddYears(-tuoi))
            tuoi--;

        return tuoi < 0 ? 0 : tuoi;
    }

    private string FormatDate(DateTime date)
    {
        if (date == DateTime.MinValue)
            return "--";

        return date.ToString("dd/MM/yyyy");
    }

    private string GetGioiTinh(Benhnhan item)
    {
        if (item == null)
            return "--";

        if (item.Gioitinh == 1)
            return "Nam";

        if (item.Gioitinh == 0)
            return "Nữ";

        return "--";
    }

    private string EmptyText(string value)
    {
        return string.IsNullOrWhiteSpace(value) ? "--" : value;
    }

    private string GetInitials(string fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName))
            return "BN";

        string[] parts = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);

        if (parts.Length == 1)
            return parts[0].Substring(0, Math.Min(2, parts[0].Length)).ToUpperInvariant();

        return $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant();
    }

    private void GoPatients() => Navigation.NavigateTo("/doctor/patients");
    private void GoExams() => Navigation.NavigateTo("/doctor/exams");
    private void GoDiseases() => Navigation.NavigateTo("/doctor/diseases");
    private void GoAcupoints() => Navigation.NavigateTo("/doctor/acupoints");
    private void GoDiagnosisRules() => Navigation.NavigateTo("/doctor/diagnosis-rules");
    private void GoTreatmentPlans() => Navigation.NavigateTo("/doctor/treatment-plans");

    public void Dispose()
    {
        objectSpace?.Dispose();
    }
}