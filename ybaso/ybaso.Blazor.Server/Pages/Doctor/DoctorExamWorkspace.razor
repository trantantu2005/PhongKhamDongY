                Nhom = NhomChiDo.ChiDuoi
            },
            new
            {
                TT = 8,
                Ten = "Thận",
                Nhom = NhomChiDo.ChiDuoi
            },
            new
            {
                TT = 9,
                Ten = "Đảm",
                Nhom = NhomChiDo.ChiDuoi
            },
            new
            {
                TT = 10,
                Ten = "Vị",
                Nhom = NhomChiDo.ChiDuoi
            },
            new
            {
                TT = 11,
                Ten = "Can",
                Nhom = NhomChiDo.ChiDuoi
            },
            new
            {
                TT = 12,
                Ten = "Tỳ",
                Nhom = NhomChiDo.ChiDuoi
            }
        };

        bool changed = false;

        foreach (var item in macDinh)
        {
            CakhamSoDoChiTiet dong =
                CaKham.SoDoChiTiets
                    .FirstOrDefault(
                        x => x.TinhHuyet == item.Ten
                    );

            if (dong == null)
            {
                dong =
                    objectSpace
                        .CreateObject<CakhamSoDoChiTiet>();

                dong.Cakham = CaKham;
                dong.TinhHuyet = item.Ten;

                changed = true;
            }

            if (dong.TT != item.TT)
            {
                dong.TT = item.TT;
                changed = true;
            }

            if (dong.NhomChi != item.Nhom)
            {
                dong.NhomChi = item.Nhom;
                changed = true;
            }
        }

        if (changed)
        {
            objectSpace.CommitChanges();
        }
    }

    private TEnum ParseEnum<TEnum>(
        string value,
        TEnum defaultValue)
        where TEnum : struct
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return defaultValue;
        }

        if (Enum.TryParse(
                value,
                true,
                out TEnum result))
        {
            return result;
        }

        return defaultValue;
    }

