    protected override void OnInitialized()
    {
        objectSpace =
            ObjectSpaceFactory.CreateObjectSpace(
                typeof(Cakham)
            );

        LoadData();
    }

    private void LoadData()
    {
        Exams =
            objectSpace
                .GetObjects<Cakham>()
                .ToList();

        Herbs =
            objectSpace
                .GetObjects<DuocLieu>()
                .ToList();

        Medicines =
            objectSpace
                .GetObjects<DanhMucThuoc>()
                .ToList();

        Imports =
            objectSpace
                .GetObjects<PhieuNhapKho>()
                .ToList();

        Exports =
            objectSpace
                .GetObjects<PhieuXuatKho>()
                .ToList();

        Invoices =
            objectSpace
                .GetObjects<HoaDonBenhNhan>()
                .ToList();
    }

    private void ReloadData()
    {
        try
        {
            objectSpace.Refresh();
            LoadData();

            MessageClass =
                "mf-alert mf-alert-success";

            Message =
                "Đã làm mới dữ liệu báo cáo.";
        }
        catch (Exception ex)
        {
            MessageClass =
                "mf-alert mf-alert-danger";

            Message =
                "Không thể làm mới báo cáo: " +
                ErrorMessage(ex);
        }
    }

