    private bool TrySaveThongTinCaKham(
        bool hienThongBaoThanhCong)
    {
        if (CaKham == null)
        {
            MessageClass =
                "mf-alert mf-alert-danger";

            Message =
                "Không tìm thấy ca khám hiện tại.";

            ActiveTab = "thongtin";
            return false;
        }

        try
        {
            if (!int.TryParse(
                    SelectedBenhNhanOid,
                    out int benhNhanOid))
            {
                MessageClass =
                    "mf-alert mf-alert-danger";

                Message =
                    "Vui lòng chọn bệnh nhân.";

                ActiveTab = "thongtin";
                return false;
            }

            Benhnhan benhNhan =
                objectSpace.GetObjectByKey<Benhnhan>(
                    benhNhanOid
                );

            if (benhNhan == null)
            {
                MessageClass =
                    "mf-alert mf-alert-danger";

                Message =
                    "Không tìm thấy bệnh nhân đã chọn.";

                ActiveTab = "thongtin";
                return false;
            }

            Nhanvien bacSi = null;

            if (!string.IsNullOrWhiteSpace(
                    SelectedBacSiOid))
            {
                if (!int.TryParse(
                        SelectedBacSiOid,
                        out int bacSiOid))
                {
                    MessageClass =
                        "mf-alert mf-alert-danger";

                    Message =
                        "Thông tin bác sĩ không hợp lệ.";

                    ActiveTab = "thongtin";
                    return false;
                }

                bacSi =
                    objectSpace
                        .GetObjectByKey<Nhanvien>(
                            bacSiOid
                        );

                if (bacSi == null)
                {
                    MessageClass =
                        "mf-alert mf-alert-danger";

                    Message =
                        "Không tìm thấy bác sĩ đã chọn.";

                    ActiveTab = "thongtin";
                    return false;
                }
            }

            CaKham.BenhNhan = benhNhan;
            CaKham.Bacsi = bacSi;
            CaKham.NgayCT = NgayKham;

            CaKham.Tuoi =
                TinhTuoi(benhNhan.Ngaysinh);

            CaKham.Chieucao = ChieuCao;
            CaKham.Cannang = CanNang;

            CaKham.NhietDoMoiTruong =
                NhietDoMoiTruong;

            CaKham.LydoKham = LyDoKham;

            CaKham.LoaiLuotKham =
                ParseEnum(
                    LoaiLuotKhamValue,
                    LoaiLuotKham.BenhNhanMoi
                );

            CaKham.LoaiCakham =
                ParseEnum(
                    LoaiCaKhamValue,
                    LoaiCaKham.TrucTiep
                );

            CaKham.TrangThai =
                ParseEnum(
                    TrangThaiValue,
                    TrangThaiCaKham.ChoKham
                );

            objectSpace.CommitChanges();

            if (hienThongBaoThanhCong)
            {
                MessageClass =
                    "mf-alert mf-alert-success";

                Message =
                    "Đã lưu thông tin ca khám thành công.";
            }

            return true;
        }
        catch (Exception ex)
        {
            MessageClass =
                "mf-alert mf-alert-danger";

            Message =
                "Lỗi khi lưu thông tin ca khám: "
                + ex.Message;

            ActiveTab = "thongtin";
            return false;
        }
    }

    private void SaveThongTinCaKham()
    {
        if (!TrySaveThongTinCaKham(true))
        {
            return;
        }

        LoadData();
    }

    private void CreatePrescription()
    {
        /*
