@page "/staff/medicines"

@using DevExpress.ExpressApp
@using ybaso.Module.BusinessObjects
@implements IDisposable

@inject IObjectSpaceFactory ObjectSpaceFactory
@inject NavigationManager Navigation

<div class="staff-page">
    <StaffSidebar ActiveMenu="medicines" />

    <main class="staff-main">
        <header class="mf-topbar">
            <div>
                <h1>Danh mục thuốc</h1>
                <p>
                    Quản lý thuốc thành phẩm, đơn vị tính, tồn kho,
                    giá bán và trạng thái sử dụng.
                </p>
            </div>

            <div class="mf-actions">
                <div class="mf-search">
                    <span>🔍</span>

                    <input placeholder="Tìm mã thuốc, tên thuốc hoặc đơn vị tính..."
                           @bind="SearchText"
                           @bind:event="oninput" />
                </div>

                <button class="mf-btn mf-btn-outline"
                        type="button"
                        @onclick="ReloadData">
                    Làm mới
                </button>

                <button class="mf-btn mf-btn-primary"
                        type="button"
                        @onclick="CreateMedicine">
                    + Thêm thuốc
                </button>
            </div>
        </header>

        @if (!string.IsNullOrWhiteSpace(Message))
        {
            <div class="@MessageClass">
                @Message
            </div>
        }

        <section class="staff-stats">
            <div class="staff-stat-card">
                <div class="staff-stat-icon teal">💊</div>

                <div>
                    <p>Tổng thuốc</p>
                    <h3>@TongThuoc</h3>
                </div>
            </div>

            <div class="staff-stat-card">
                <div class="staff-stat-icon green">✅</div>

                <div>
                    <p>Đang sử dụng</p>
                    <h3>@ThuocDangDung</h3>
                </div>
            </div>

            <div class="staff-stat-card">
                <div class="staff-stat-icon orange">⚠️</div>

                <div>
                    <p>Cần nhập thêm</p>
                    <h3>@ThuocSapHet</h3>
                </div>
            </div>

            <div class="staff-stat-card">
                <div class="staff-stat-icon blue">📋</div>

                <div>
                    <p>Đang hiển thị</p>
                    <h3>@DanhSachLoc.Count()</h3>
                </div>
            </div>
        </section>

        <section class="mf-card">
            <div class="mf-card-head">
                <div>
                    <h2>Danh sách thuốc</h2>

                    <p>
                        Hiển thị @DanhSachLoc.Count()
                        trong tổng số @TongThuoc thuốc.
                    </p>
                </div>

                <div class="staff-filter-group">
                    <button class="@GetFilterButtonClass("all")"
                            type="button"
                            @onclick='() => SetFilter("all")'>
                        Tất cả
                    </button>

                    <button class="@GetFilterButtonClass("active")"
                            type="button"
                            @onclick='() => SetFilter("active")'>
                        Đang dùng
                    </button>

                    <button class="@GetFilterButtonClass("low")"
                            type="button"
                            @onclick='() => SetFilter("low")'>
                        Sắp hết
                    </button>

                    <button class="@GetFilterButtonClass("inactive")"
                            type="button"
                            @onclick='() => SetFilter("inactive")'>
                        Ngừng dùng
                    </button>
                </div>
            </div>

            <table class="mf-table">
                <thead>
                    <tr>
                        <th>Thuốc</th>
                        <th>Đơn vị tính</th>
                        <th>Tồn kho</th>
                        <th>Tồn tối thiểu</th>
                        <th>Giá bán</th>
                        <th>Trạng thái kho</th>
                        <th>Sử dụng</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in DanhSachLoc)
                    {
                        <tr>
                            <td>
                                <div class="staff-cell-main">
                                    <div class="staff-circle">
                                        T
                                    </div>

                                    <div>
                                        <strong>
                                            @EmptyText(item.TenThuoc)
                                        </strong>

                                        <small>
                                            @GetMedicineCode(item)
                                        </small>
                                    </div>
                                </div>
                            </td>

                            <td>
                                @GetDonViTinh(item)
                            </td>

                            <td>
                                <strong>
                                    @FormatNumber(item.SoLuongTon)
                                </strong>
                            </td>

                            <td>
                                @FormatNumber(item.TonToiThieu)
                            </td>

                            <td>
                                <strong>
                                    @FormatMoney(item.GiaBan)
                                </strong>
                            </td>

                            <td>
                                <span class="@GetStockStatusClass(item)">
                                    @GetStockStatusText(item)
                                </span>
                            </td>

                            <td>
                                <span class="@GetUseStatusClass(item)">
                                    @(item.SuDung
                                        ? "Đang dùng"
                                        : "Ngừng dùng")
                                </span>
                            </td>

                            <td>
                                <button class="staff-table-btn"
                                        type="button"
                                        @onclick="() => EditMedicine(item.Oid)">
                                    Cập nhật
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            @if (!DanhSachLoc.Any())
            {
                <div class="mf-empty">
                    Không tìm thấy thuốc phù hợp.
                </div>
            }
        </section>
    </main>
</div>

@code {
    private IObjectSpace objectSpace;

    private string SearchText = string.Empty;
    private string FilterMode = "all";

    private string Message = string.Empty;
    private string MessageClass = "mf-alert mf-alert-success";

    private List<DanhMucThuoc> DanhSachThuoc = new();

    private int TongThuoc =>
        DanhSachThuoc.Count;

    private int ThuocDangDung =>
        DanhSachThuoc.Count(x => x.SuDung);

    private int ThuocSapHet =>
        DanhSachThuoc.Count(x =>
            x.SuDung &&
            x.SoLuongTon <= x.TonToiThieu
        );

    private IEnumerable<DanhMucThuoc> DanhSachLoc
    {
        get
        {
            IEnumerable<DanhMucThuoc> query =
                DanhSachThuoc.OrderBy(x => x.TenThuoc);

            if (FilterMode == "active")
            {
                query = query.Where(x => x.SuDung);
            }
            else if (FilterMode == "inactive")
            {
                query = query.Where(x => !x.SuDung);
            }
            else if (FilterMode == "low")
            {
                query = query.Where(x =>
                    x.SuDung &&
                    x.SoLuongTon <= x.TonToiThieu
                );
            }

            if (string.IsNullOrWhiteSpace(SearchText))
                return query;

            string keyword =
                SearchText.Trim().ToLowerInvariant();

            return query.Where(x =>
                (x.MaThuoc ?? string.Empty)
                    .ToLowerInvariant()
                    .Contains(keyword) ||

                (x.TenThuoc ?? string.Empty)
                    .ToLowerInvariant()
                    .Contains(keyword) ||

                GetDonViTinh(x)
                    .ToLowerInvariant()
                    .Contains(keyword)
            );
        }
    }

    protected override void OnInitialized()
    {
        objectSpace =
            ObjectSpaceFactory.CreateObjectSpace(
                typeof(DanhMucThuoc)
            );

        LoadData();
    }

    private void LoadData()
    {
        DanhSachThuoc =
            objectSpace
                .GetObjects<DanhMucThuoc>()
                .OrderBy(x => x.TenThuoc)
                .ToList();
    }

    private void ReloadData()
    {
        objectSpace.Refresh();
        LoadData();

        MessageClass = "mf-alert mf-alert-success";
        Message = "Đã làm mới danh mục thuốc.";
    }

    private void CreateMedicine()
    {
        Navigation.NavigateTo("/staff/medicines/new");
    }

    private void EditMedicine(int oid)
    {
        Navigation.NavigateTo(
            $"/staff/medicines/edit/{oid}"
        );
    }

    private void SetFilter(string mode)
    {
        FilterMode = mode;
    }

    private string GetFilterButtonClass(string mode)
    {
        return FilterMode == mode
            ? "staff-filter-btn active"
            : "staff-filter-btn";
    }

    private string GetMedicineCode(DanhMucThuoc item)
    {
        if (!string.IsNullOrWhiteSpace(item?.MaThuoc))
            return item.MaThuoc;

        if (item == null)
            return "--";

        return $"TH-{item.Oid:0000}";
    }

    private string GetDonViTinh(DanhMucThuoc item)
    {
        return item?.DonViTinh?.TenDvt ?? "--";
    }

    private string GetStockStatusText(DanhMucThuoc item)
    {
        if (item == null || item.SoLuongTon <= 0)
            return "Hết hàng";

        if (item.SoLuongTon <= item.TonToiThieu)
            return "Sắp hết";

        return "Còn hàng";
    }

    private string GetStockStatusClass(DanhMucThuoc item)
    {
        if (item == null || item.SoLuongTon <= 0)
            return "staff-status danger";

        if (item.SoLuongTon <= item.TonToiThieu)
            return "staff-status warning";

        return "staff-status success";
    }

    private string GetUseStatusClass(DanhMucThuoc item)
    {
        return item != null && item.SuDung
            ? "staff-status success"
            : "staff-status neutral";
    }

    private string EmptyText(string value)
    {
        return string.IsNullOrWhiteSpace(value)
            ? "--"
            : value;
    }

    private string FormatMoney(decimal value)
    {
        return value.ToString("n0");
    }

    private string FormatNumber(decimal value)
    {
        return value.ToString("n0");
    }

    public void Dispose()
    {
        objectSpace?.Dispose();
    }
}