    private void SelectTab(string tab)
    {
        ActiveTab = tab;
        SearchText = string.Empty;
    }

    private void SelectInventoryTab(string tab)
    {
        InventoryTab = tab;
        SearchText = string.Empty;
    }

    private void SetRange(string range)
    {
        DateTime today =
            DateTime.Today;

        QuickRange = range;

        if (range == "7days")
        {
            TuNgay = today.AddDays(-6);
            DenNgay = today;
        }
        else if (range == "month")
        {
            TuNgay =
                new DateTime(
                    today.Year,
                    today.Month,
                    1
                );

            DenNgay = today;
        }
        else if (range == "year")
        {
            TuNgay =
                new DateTime(
                    today.Year,
                    1,
                    1
                );

            DenNgay = today;
        }
        else
        {
            TuNgay = today;
            DenNgay = today;
            QuickRange = "today";
        }

        Message = string.Empty;
    }

    private void ChangeFromDate(
        ChangeEventArgs e)
    {
        if (DateTime.TryParse(
            e.Value?.ToString(),
            out DateTime value))
        {
            TuNgay = value.Date;
            QuickRange = "custom";
        }
    }

    private void ChangeToDate(
        ChangeEventArgs e)
    {
        if (DateTime.TryParse(
            e.Value?.ToString(),
            out DateTime value))
        {
            DenNgay = value.Date;
            QuickRange = "custom";
        }
    }

    private void ApplyRange()
    {
        if (TuNgay > DenNgay)
        {
            MessageClass =
                "mf-alert mf-alert-danger";

            Message =
                "Từ ngày không được lớn hơn đến ngày.";

            return;
        }

        MessageClass =
            "mf-alert mf-alert-success";

        Message =
            "Đã áp dụng khoảng thời gian báo cáo.";
    }

    private bool InRange(DateTime date)
    {
        return
            date >= RangeStart &&
            date < RangeEnd;
    }

    private bool Match(
        params string[] values)
    {
        if (string.IsNullOrWhiteSpace(
            SearchText))
        {
            return true;
        }

        string keyword =
            SearchText
                .Trim()
                .ToLowerInvariant();

        return values.Any(x =>
            (x ?? string.Empty)
                .ToLowerInvariant()
                .Contains(keyword)
        );
    }

