@page "/staff/prescriptions"
@page "/staff/exports"

@using DevExpress.ExpressApp
@using Microsoft.AspNetCore.Components.Authorization
@using ybaso.Module.BusinessObjects
@implements IDisposable

@inject IObjectSpaceFactory ObjectSpaceFactory
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider

<div class="staff-page">
    <StaffSidebar ActiveMenu="exports" />

    <main class="staff-main">
        <header class="mf-topbar">
            <div>
                <h1>Phiếu xuất kho</h1>
                <p>
                    Tiếp nhận đơn thuốc đã kê, kiểm tra tồn kho
                    và thực hiện xuất thuốc cho bệnh nhân.
                </p>
            </div>

            <div class="mf-actions">
                <div class="mf-search">
                    <span>🔍</span>
                    <input placeholder="Tìm bệnh nhân, chẩn đoán, trạng thái..."
                           @bind="SearchText"
                           @bind:event="oninput" />
                </div>

                <button class="mf-btn mf-btn-outline" type="button" @onclick="ReloadData">
                    Làm mới
                </button>
            </div>
        </header>

        @if (!string.IsNullOrWhiteSpace(Message))
        {
            <div class="@MessageClass">
                @Message
            </div>
        }

        <section class="staff-stats">
            <div class="staff-stat-card">
                <div class="staff-stat-icon orange">💊</div>
                <div>
                    <p>Chờ xuất</p>
                    <h3>@DonChoXuat</h3>
                </div>
            </div>

            <div class="staff-stat-card">
                <div class="staff-stat-icon green">✅</div>
                <div>
                    <p>Đã xuất</p>
                    <h3>@DonDaXuat</h3>
                </div>
            </div>

            <div class="staff-stat-card">
                <div class="staff-stat-icon blue">📅</div>
                <div>
                    <p>Kê hôm nay</p>
                    <h3>@DonHomNay</h3>
                </div>
            </div>

            <div class="staff-stat-card">
                <div class="staff-stat-icon teal">📋</div>
                <div>
                    <p>Tổng đơn</p>
                    <h3>@TongDonThuoc</h3>
                </div>
            </div>
        </section>

        <section class="mf-card">
            <div class="mf-card-head">
                <div>
                    <h2>Danh sách đơn thuốc</h2>
                    <p>Hiển thị @DanhSachLoc.Count() trong tổng số @TongDonThuoc đơn thuốc.</p>
                </div>

                <div class="staff-filter-group">
                    <button class="@GetFilterButtonClass("waiting")" type="button" @onclick='() => SetFilter("waiting")'>
                        Chờ xuất
                    </button>

                    <button class="@GetFilterButtonClass("all")" type="button" @onclick='() => SetFilter("all")'>
                        Tất cả
                    </button>

                    <button class="@GetFilterButtonClass("exported")" type="button" @onclick='() => SetFilter("exported")'>
                        Đã xuất
                    </button>

                    <button class="@GetFilterButtonClass("today")" type="button" @onclick='() => SetFilter("today")'>
                        Hôm nay
                    </button>
                </div>
            </div>

            <table class="mf-table">
                <thead>
                    <tr>
                        <th>Bệnh nhân</th>
                        <th>Ca khám</th>
                        <th>Ngày kê</th>
                        <th>Chẩn đoán</th>
                        <th>Trạng thái</th>
                        <th>Tổng tiền</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in DanhSachLoc)
                    {
                        <tr>
                            <td>
                                <div class="staff-cell-main">
                                    <div class="staff-circle">
                                        @GetInitials(GetTenBenhNhan(item))
                                    </div>

                                    <div>
                                        <strong>@GetTenBenhNhan(item)</strong>
                                        <small>@GetDienThoaiBenhNhan(item)</small>
                                    </div>
                                </div>
                            </td>

                            <td>@GetTenCaKham(item)</td>
                            <td>@FormatDateTime(item.NgayKeDon)</td>
                            <td>@EmptyText(item.ChanDoan)</td>

                            <td>
                                <span class="@GetStatusClass(item)">
                                    @item.TrangThai
                                </span>
                            </td>

                            <td>
                                <strong>@FormatMoney(GetTongTien(item))</strong>
                            </td>

                            <td>
                                <button class="staff-table-btn" type="button" @onclick="() => OpenPrescription(item.Oid)">
                                    Xử lý
                                </button>

                                @if (item.Ca != null)
                                {
                                    <button class="staff-table-btn light" type="button" @onclick="() => OpenExam(item.Ca.Oid)">
                                        Ca khám
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            @if (!DanhSachLoc.Any())
            {
                <div class="mf-empty">
                    Không có đơn thuốc phù hợp.
                </div>
            }
        </section>
    </main>
</div>

@code {
    private IObjectSpace objectSpace;

    private string CurrentUserName = "Nhân viên";
    private string SearchText = "";
    private string FilterMode = "waiting";

    private string Message = "";
    private string MessageClass = "mf-alert mf-alert-success";

    private List<DonThuoc> DanhSachDonThuoc = new();

    private int TongDonThuoc => DanhSachDonThuoc.Count;
    private int DonHomNay => DanhSachDonThuoc.Count(x => x.NgayKeDon.Date == DateTime.Today);
    private int DonChoXuat => DanhSachDonThuoc.Count(x => IsChuaXuat(x));
    private int DonDaXuat => DanhSachDonThuoc.Count(x => IsDaXuat(x));

    private IEnumerable<DonThuoc> DanhSachLoc
    {
        get
        {
            IEnumerable<DonThuoc> query = DanhSachDonThuoc
                .OrderByDescending(x => x.NgayKeDon);

            if (FilterMode == "waiting")
            {
                query = query.Where(x => IsChuaXuat(x));
            }

            if (FilterMode == "exported")
            {
                query = query.Where(x => IsDaXuat(x));
            }

            if (FilterMode == "today")
            {
                query = query.Where(x => x.NgayKeDon.Date == DateTime.Today);
            }

            if (string.IsNullOrWhiteSpace(SearchText))
                return query;

            string keyword = SearchText.Trim().ToLowerInvariant();

            return query.Where(x =>
                GetTenBenhNhan(x).ToLowerInvariant().Contains(keyword) ||
                GetDienThoaiBenhNhan(x).ToLowerInvariant().Contains(keyword) ||
                GetTenCaKham(x).ToLowerInvariant().Contains(keyword) ||
                (x.ChanDoan ?? "").ToLowerInvariant().Contains(keyword) ||
                x.TrangThai.ToString().ToLowerInvariant().Contains(keyword)
            );
        }
    }

    protected override async Task OnInitializedAsync()
    {
        objectSpace = ObjectSpaceFactory.CreateObjectSpace(typeof(DonThuoc));

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        CurrentUserName = authState.User?.Identity?.Name ?? "Nhân viên";

        LoadData();
    }

    private void LoadData()
    {
        DanhSachDonThuoc = objectSpace.GetObjects<DonThuoc>()
            .OrderByDescending(x => x.NgayKeDon)
            .ToList();
    }

    private void ReloadData()
    {
        objectSpace.Refresh();
        LoadData();

        MessageClass = "mf-alert mf-alert-success";
        Message = "Đã làm mới danh sách đơn thuốc.";
    }

    private void SetFilter(string mode)
    {
        FilterMode = mode;
    }

    private string GetFilterButtonClass(string mode)
    {
        if (FilterMode == mode)
            return "staff-filter-btn active";

        return "staff-filter-btn";
    }

    private bool IsChuaXuat(DonThuoc item)
    {
        string value = item?.TrangThai.ToString().ToLowerInvariant() ?? "";
        return value.Contains("chuaxuat") || value.Contains("chờ") || value.Contains("cho");
    }

    private bool IsDaXuat(DonThuoc item)
    {
        string value = item?.TrangThai.ToString().ToLowerInvariant() ?? "";
        return value.Contains("daxuat") || value.Contains("đã") || value.Contains("da");
    }

    private string GetTenBenhNhan(DonThuoc donThuoc)
    {
        return donThuoc?.Ca?.BenhNhan?.HoTen ?? "Chưa có bệnh nhân";
    }

    private string GetDienThoaiBenhNhan(DonThuoc donThuoc)
    {
        return donThuoc?.Ca?.BenhNhan?.Dienthoai ?? "Chưa có SĐT";
    }

    private string GetTenCaKham(DonThuoc donThuoc)
    {
        if (donThuoc?.Ca == null)
            return "Chưa gắn ca khám";

        string tenBenhNhan = donThuoc.Ca.BenhNhan?.HoTen ?? "Chưa chọn bệnh nhân";

        return $"{tenBenhNhan} - {donThuoc.Ca.NgayCT:dd/MM/yyyy}";
    }

    private string GetStatusClass(DonThuoc item)
    {
        string value = item?.TrangThai.ToString().ToLowerInvariant() ?? "";

        if (value.Contains("chuaxuat") || value.Contains("cho"))
            return "staff-status warning";

        if (value.Contains("daxuat") || value.Contains("da"))
            return "staff-status success";

        if (value.Contains("huy"))
            return "staff-status danger";

        return "staff-status neutral";
    }

    private string FormatDateTime(DateTime date)
    {
        if (date == DateTime.MinValue)
            return "--";

        return date.ToString("dd/MM/yyyy HH:mm");
    }

    private string FormatMoney(decimal value)
    {
        return value.ToString("n0");
    }

    private decimal GetTongTien(DonThuoc donThuoc)
    {
        if (donThuoc == null)
            return 0;

        return donThuoc.TongTien;
    }

    private string EmptyText(string value)
    {
        return string.IsNullOrWhiteSpace(value) ? "--" : value;
    }

    private string GetInitials(string fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName))
            return "NV";

        string[] parts = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);

        if (parts.Length == 1)
            return parts[0].Substring(0, Math.Min(2, parts[0].Length)).ToUpperInvariant();

        return $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant();
    }

    private void OpenPrescription(int oid)
    {
        Navigation.NavigateTo($"/staff/exports/{oid}");
    }

    private void OpenExam(int oid)
    {
        Navigation.NavigateTo($"/staff/exams/{oid}");
    }

    private void GoPatients() => Navigation.NavigateTo("/staff/patients");
    private void GoExams() => Navigation.NavigateTo("/staff/exams");
    private void GoPrescriptions() => Navigation.NavigateTo("/staff/prescriptions");
    private void GoMedicines() => Navigation.NavigateTo("/staff/medicines");
    private void GoImports() => Navigation.NavigateTo("/staff/imports");
    private void GoExports() => Navigation.NavigateTo("/staff/exports");
    private void GoReports() => Navigation.NavigateTo("/staff/reports");

    public void Dispose()
    {
        objectSpace?.Dispose();
    }
}