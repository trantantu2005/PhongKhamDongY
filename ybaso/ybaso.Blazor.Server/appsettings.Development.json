{
  "DetailedErrors": true,

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Information",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.AspNetCore.Components": "Debug",
      "Microsoft.AspNetCore.Components.Server": "Debug",
      "Microsoft.AspNetCore.Components.Server.Circuits": "Debug",
      "Microsoft.AspNetCore.SignalR": "Debug",
      "DevExpress": "Information",
      "DevExpress.ExpressApp": "Debug"
    }
  },

  "DevExpress": {
    "ExpressApp": {
      "EnableDiagnosticActions": true
    }
  }
}