    private int TinhTuoi(DateTime ngaySinh)
    {
        if (ngaySinh == DateTime.MinValue)
        {
            return 0;
        }

        int tuoi =
            DateTime.Today.Year - ngaySinh.Year;

        if (ngaySinh.Date >
            DateTime.Today.AddYears(-tuoi))
        {
            tuoi--;
        }

        return tuoi < 0 ? 0 : tuoi;
    }

    private double ParseDouble(string text)
    {
        if (string.IsNullOrWhiteSpace(text))
        {
            return 0;
        }

        text =
            text.Trim().Replace(",", ".");

        if (double.TryParse(
                text,
                NumberStyles.Any,
                CultureInfo.InvariantCulture,
                out double value))
        {
            return value;
        }

        return 0;
    }

